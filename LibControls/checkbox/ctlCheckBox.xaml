<UserControl x:Class="LibControls.checkbox.ctlCheckBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.checkbox"
             mc:Ignorable="d" 
             d:DesignHeight="42" d:DesignWidth="42">
    <Grid>
        <CheckBox x:Name="chkEstado" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" IsChecked="False" Checked="chkEstado_Checked" Unchecked="chkEstado_Unchecked">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
            </CheckBox.LayoutTransform>
        </CheckBox>
    </Grid>
</UserControl>
