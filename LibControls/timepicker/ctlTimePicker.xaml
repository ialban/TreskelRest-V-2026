<UserControl x:Class="LibControls.timepicker.ctlTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.timepicker"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="150">
    <Grid>
        <Border BorderThickness="1" BorderBrush="Black" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
            <Grid>
                <TextBlock x:Name="hinicio" Padding="7" VerticalAlignment="Top" Height="40" Width="110" FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left">
                    00:00
                </TextBlock>
                <ToggleButton x:Name="selector" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" 
                            Margin="0,3,5,5" Background="Transparent" BorderBrush="Transparent" >
                    <Image Source="../images/clock.png" Width="25" Height="25" />
                </ToggleButton>
                <Popup x:Name="popupControl" IsOpen="{Binding IsChecked ,ElementName=selector}" StaysOpen="false" Width="270">
                    <Border Background="LightYellow">
                        <DockPanel>
                            <DockPanel.Resources>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </DockPanel.Resources>
                            <StackPanel DockPanel.Dock="Bottom">
                                <Button x:Name="hInicioOk" Width="60" Height="50" Background="DarkBlue" Click="hInicioOk_Click">
                                    <Image Source="../images/clock-white.png" Width="30" Height="30" />
                                </Button>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel Orientation="Vertical">
                                    <Slider x:Name="sHora" Width="50" Height="140" Orientation="Vertical" Value="0" Maximum="23" TickPlacement="Both" IsSnapToTickEnabled="True" ValueChanged="sHora_ValueChanged" />
                                    <Label Content="Hora" />
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <Slider x:Name="sMinuto" Width="50" Height="140" Orientation="Vertical" Value="0" Maximum="59" TickPlacement="Both" IsSnapToTickEnabled="True" ValueChanged="sMinuto_ValueChanged"  />
                                    <Label Content="Minuto" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <StackPanel.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="6"></Setter>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="horaUp" Width="55" Height="50" Background="LightBlue" Click="horaUp_Click">
                                        <Image Source="../images/chevronup.png" Width="30" Height="30" />
                                    </Button>
                                    <Button x:Name="MinutoUp" Width="55" Height="50" Background="LightBlue" Click="MinutoUp_Click">
                                        <Image Source="../images/chevronup.png" Width="30" Height="30" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label x:Name="lHora" Content="00" FontSize="18" Width="60" HorizontalContentAlignment="Center"></Label>
                                    <Label Content=":" FontSize="22"></Label>
                                    <Label x:Name="lMinuto" Content="00" FontSize="22" Width="60" HorizontalContentAlignment="Center"></Label>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="horaDown" Width="55" Height="50" Background="LightBlue" Click="horaDown_Click">
                                        <Image Source="../images/chevrondown.png" Width="30" Height="30" />
                                    </Button>
                                    <Button x:Name="MinutoDown" Width="55" Height="50" Background="LightBlue" Click="MinutoDown_Click">
                                        <Image Source="../images/chevrondown.png" Width="30" Height="30" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
