<UserControl x:Class="LibControls.FactCliente.FactCliente"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.FactCliente"
             mc:Ignorable="d" Width="430" Height="100"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <GroupBox Header="Cliente"  BorderBrush="Black" BorderThickness="2">
            <StackPanel Orientation="Vertical">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Margin" Value="1"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="N° Id : " Width="55" FontSize="12" Height="30" HorizontalContentAlignment="Left" />
                            <TextBox x:Name="txtCedula" Width="154" FontSize="16" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                            <Button x:Name="btnBorrar" Margin="0" Width="50" Click="btnBorrar_Click">
                                <StackPanel Orientation="Vertical">
                                    <Image Source="{Binding DeleteImage}" Width="30" Height="30"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Cliente : " Width="55" FontSize="12" HorizontalContentAlignment="Left" />
                            <TextBox x:Name="txtCliente" IsEnabled="False" Width="205" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="btnBscCli" Width="65" Height="63" Click="btnBscCli_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding SearchImage}" Width="30" Height="30"/>
                            <Label Content="Buscar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCliFnl" Width="65" Height="63" Click="btnCliFnl_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="{Binding ClienteFinalImage}" Width="30" Height="30"/>
                            <Label Content="Cli. Final" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
