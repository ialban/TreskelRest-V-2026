<UserControl x:Class="LibControls.buttons.ButtonAddDel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.buttons"
             mc:Ignorable="d" Width="246" Height="81">
    <Grid Margin="0,0,0,0">
        <Button x:Name="Boton" Width="200" Height="80" HorizontalAlignment="Left" VerticalAlignment="Top" Click="Boton_Click" Margin="0,0,0,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"></Setter>
                </Style>
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Height="70" Width="180">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </StackPanel.Resources>
                <TextBlock x:Name="codigo" Height="70" Width="180" TextAlignment="Center"  Text="Contenido" TextWrapping="Wrap" FontSize="14" />
            </StackPanel>
        </Button>
        <Button x:Name="BotonAdd" Width="50" Height="40" HorizontalAlignment="Left" Click="BotonAdd_Click" Margin="195,0,0,0" VerticalAlignment="Top" Background="#F7C5BC">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="imgAdd" Width="25" Height="25" Source="/LibControls;component/images/add.png" />
            </StackPanel>
        </Button>
        <Button x:Name="BotonDel" Width="50" Height="40" HorizontalAlignment="Left" Click="BotonDel_Click" Margin="195,40,0,0" VerticalAlignment="Top" Background="#CAECA5">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="imgDel" Width="25" Height="25" Source="/LibControls;component/images/minus.png" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
