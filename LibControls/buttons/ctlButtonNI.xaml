<UserControl x:Class="LibControls.buttons.ctlButtonNI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.buttons"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="210">
    <Grid>
        <Button x:Name="Boton" Width="195" Height="80" HorizontalAlignment="Left" HorizontalContentAlignment="Left" PreviewMouseDown="Boton_PreviewMouseDown" Click="Button_Click" MouseDoubleClick="Button_MouseDoubleClick">
            <StackPanel x:Name="stackTexto" Orientation="Vertical" Width="192" >
                <StackPanel.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                    <Style TargetType="{x:Type Label}">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="imagen" Height="0" Width="80" Source="../images/imgDefault.png" />
                <Label x:Name="codigo" Content="L" FontSize="14" />
                <TextBlock x:Name="titulo" FontSize="12" Margin="3,3,3,3" TextWrapping="Wrap">000</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="Editar" Width="30" Height="80" HorizontalAlignment="Right" VerticalContentAlignment="Center" Click="Editar_Click" Visibility="Hidden" Content="..." FontSize="30" Background="#FFE0C2C2" />
    </Grid>
</UserControl>
