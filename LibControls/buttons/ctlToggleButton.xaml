<UserControl x:Class="LibControls.buttons.ctlToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.buttons"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="90">
    <Grid>
        <ToggleButton x:Name="Boton" HorizontalContentAlignment="Left" Checked="Boton_Checked" Unchecked="Boton_Unchecked">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="4"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="imagen" Width="40" Height="40" Visibility="Visible" />
                <StackPanel Orientation="Vertical" x:Name="stackTexto">
                    <Label x:Name="codigo" Content="L" FontSize="14" />
                    <TextBlock x:Name="titulo" FontSize="14" TextWrapping="Wrap">000</TextBlock>
                </StackPanel>
            </StackPanel>
        </ToggleButton>
    </Grid>
</UserControl>
