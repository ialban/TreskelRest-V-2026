<UserControl x:Class="LibControls.contenedor.ctlGrpProd"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.contenedor"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1000" Margin="0,0,0,0">
    <Grid x:Name ="ctlOrgGrpProd" Height="Auto" Width="Auto" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0">
        <!-- <StackPanel x:Name="contGrupo" Orientation="Vertical" Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Stretch">-->
        <Grid x:Name="contGrupo" Width="Auto" HorizontalAlignment="Left" VerticalAlignment="top" Margin="3,3,0,0" Height="200">
            <Label x:Name="lblGrupo" Content="Grupo" FontSize="16" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0"/>
            <ScrollViewer x:Name="GrupoScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="150" CanContentScroll="True" 
                          Margin="0,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" >
                <ScrollViewer.Resources>
                    <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                        <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="30" />
                                <Setter Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="MinWidth" Value="30" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>
                <UniformGrid x:Name="grupoContainer" Width="auto"
                     Columns="9"
                     Rows = "2"
                     Height="140"
                     Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </UniformGrid.Resources>
                </UniformGrid>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="contProd" Width="Auto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,200,0,0" Height="Auto">
            <Label x:Name="lblProds" Content="Productos" FontSize="16" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" />
            <ScrollViewer x:Name="ProdScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="Auto" CanContentScroll="True" 
                          Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <ScrollViewer.Resources>
                    <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                        <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="30" />
                                <Setter Property="MinHeight" Value="30" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="30" />
                                <Setter Property="MinWidth" Value="30" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Resources>
                <UniformGrid x:Name="productosContainer" Width="auto"
                     Columns="9"
                     Margin="0,30,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </UniformGrid.Resources>

                </UniformGrid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
