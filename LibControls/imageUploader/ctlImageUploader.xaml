<UserControl x:Class="LibControls.imageUploader.ctlImageUploader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.imageUploader"
             mc:Ignorable="d" 
             d:DesignHeight="230" d:DesignWidth="185">
    <Grid>
        <Border BorderThickness="2" BorderBrush="#FF000000" Height="180" Width="180" Margin="3,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image x:Name="icono" Source="../images/noimage.png" HorizontalAlignment="Left" Height="165" Margin="5,5,0,0" VerticalAlignment="Top" Width="165">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="mnuPegar" Header="Pegar"  Click="mnuPegar_Click">
                            <MenuItem.Icon>
                                <Image x:Name="Paste" Source="../images/paste.png" Height="16" Width="16" Margin="-2,-4,-4,-4" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="mnuLimpiar" Header="Eliminar"  Click="mnuLimpiar_Click">
                            <MenuItem.Icon>
                                <Image x:Name="Delete" Source="../images/delete.png" Height="16" Width="16" Margin="-2,-4,-4,-4" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Border>
        <Button x:Name="btnLoad" HorizontalAlignment="Left" Margin="3,188,0,0" VerticalAlignment="Top" Width="100" Height="40" Foreground="White" FontSize="16" Click="btnLoad_Click" Background="#5cb85c">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="upload" Source="../images/upload.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center"><Run Text="Cargar"/></TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnNoImage" HorizontalAlignment="Left" Margin="108,188,0,0" VerticalAlignment="Top" Width="74" Height="40" Foreground="White" FontSize="16" Click="btnNoImage_Click" Background="#d9534f">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image x:Name="limpiar" Source="../images/noimage.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

    </Grid>
</UserControl>
