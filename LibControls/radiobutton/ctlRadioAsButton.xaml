<UserControl x:Class="LibControls.radiobutton.ctlRadioAsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.radiobutton"
             mc:Ignorable="d" 
             d:DesignHeight="90" d:DesignWidth="90">
    <Grid x:Name="objGrid" Margin="0,0,0,0" Background="Gray" Width="90" Height="90">
        <RadioButton Margin="5,5,5,5" x:Name="RbButton" Tag="BP" Height="70" Width="70" 
                     Style="{StaticResource styleRadioToggleTheme3}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Vertical">
                <Image Source="../images/save.png" Width="40" Height="40" />
                <Label x:Name="lblRadioText" Content="texto" Foreground="Black" FontSize="10" />
            </StackPanel>
        </RadioButton>
    </Grid>
</UserControl>
