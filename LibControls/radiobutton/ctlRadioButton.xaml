<UserControl x:Class="LibControls.radiobutton.ctlRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibControls.radiobutton"
             mc:Ignorable="d" 
             d:DesignHeight="42" d:DesignWidth="42">
    <Grid>
        <RadioButton x:Name="rbOpcion" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" IsChecked="False" Checked="rbOpcion_Checked" Unchecked="rbOpcion_Unchecked">
            <RadioButton.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </RadioButton.LayoutTransform>
        </RadioButton>
    </Grid>
</UserControl>
