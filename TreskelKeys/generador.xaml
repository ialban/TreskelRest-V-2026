<Window x:Class="TreskelKeys.generador"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TreskelKeys"
        mc:Ignorable="d"
        Title="Generador de claves para productos Treskel" Height="479.685" Width="672.695">
    <Grid>

        <GroupBox x:Name="groupBox" Header="Por Código de PC" HorizontalAlignment="Left" Height="209" Margin="10,10,0,0" VerticalAlignment="Top" Width="645">
            <Grid>
                <Label x:Name="label" Content="Código PC" HorizontalAlignment="Left" Margin="10,72,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtProdID" HorizontalAlignment="Left" Height="23" Margin="133,76,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="386"/>
                <Button x:Name="btnGenerar1" Content="Generar" HorizontalAlignment="Left" Margin="535,76,0,0" VerticalAlignment="Top" Width="88" Height="23" Click="btnGenerar1_Click"/>
                <Label x:Name="label1" Content="Código Generado" HorizontalAlignment="Left" Margin="10,119,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtProdKey" HorizontalAlignment="Left" Height="26" Margin="133,119,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="386"/>
                <Button x:Name="btnCopiar1" Content="Copiar" HorizontalAlignment="Left" Margin="535,119,0,0" VerticalAlignment="Top" Width="88" Height="26" Click="btnCopiar1_Click"/>
                <Label Content="Tipo Licencia" HorizontalAlignment="Left" Margin="10,23,0,0" VerticalAlignment="Top"/>
                <ComboBox x:Name="cboTipo" HorizontalAlignment="Left" Margin="133,23,0,0" VerticalAlignment="Top" Width="120" Height="26">
                    <ComboBoxItem Tag="P" VerticalContentAlignment="Center" Content="Prueba" />
                    <ComboBoxItem Tag="C" VerticalContentAlignment="Center" Content="Completa" />
                </ComboBox>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="groupBox1" Header="Por Código de Seguridad" HorizontalAlignment="Left" Height="215" Margin="10,224,0,0" VerticalAlignment="Top" Width="645">
            <Grid>
                <Label x:Name="label2" Content="Código 1" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Label x:Name="label3" Content="Código 2" HorizontalAlignment="Left" Margin="205,10,0,0" VerticalAlignment="Top"/>
                <Label x:Name="label4" Content="Código 3" HorizontalAlignment="Left" Margin="416,10,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtCodigo1" HorizontalAlignment="Left" Height="26" Margin="85,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="103" MaxLength="2"/>
                <TextBox x:Name="txtCodigo2" HorizontalAlignment="Left" Height="26" Margin="280,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="103" MaxLength="2"/>
                <TextBox x:Name="txtCodigo3" HorizontalAlignment="Left" Height="26" Margin="500,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="103" MaxLength="2"/>
                <Button x:Name="btnGenerar2" Content="Generar" HorizontalAlignment="Left" Margin="220,50,0,0" VerticalAlignment="Top" Width="90" Height="29" Click="btnGenerar2_Click"/>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="10,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image1"  Height="86" Margin="2,2,0,0"  Width="86"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="116,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image2" Height="86" Margin="2,2,0,0" Width="86"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="220,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image3" Height="86" Margin="2,2,0,0" Width="86"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="325,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image4" Height="86" Margin="2,2,0,0" Width="86"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="430,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image5" Height="86" Margin="2,2,0,0" Width="86"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="90" Width="90" Margin="532,97,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="image6" Height="86" Margin="2,2,0,0" Width="86"/>
                </Border>
                <Button x:Name="btnCopiar2" Content="Copiar" HorizontalAlignment="Left" Margin="325,50,0,0" VerticalAlignment="Top" Width="90" Height="29" Click="btnCopiar2_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
