<UserControl x:Class="TreskelRest.frms.ctls.ctlTipPrints"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="390" d:DesignWidth="720">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <GroupBox Header="Definición de tipos de Impresoras" Height="330" Margin="5,5,5,5">
                <Grid>
                    <Label Content="Para Facturación: " Margin="5, 50, 0, 0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <Label Content="Tipo" Margin="140, 10, 0, 0" Height="40" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboTipoFact" FontFamily="Courier New" Width="110" Height="40" Margin="120,50,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Impacto" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="Térmica" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <Label Content="Marca" Margin="260, 10, 0, 0" Height="40" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboMarcaFact" FontFamily="Courier New" Width="150" Height="40" Margin="243,50,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Epson" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="SAT" Height="40" VerticalContentAlignment="Center" />
                        <ComboBoxItem Content="ZKTeco" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <Label Content="Usa espacios:" Margin="405,50,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkEspFact" Margin="500,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <Label Content="Para Cocina: " Margin="5, 100, 0, 0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboTipoCocina" FontFamily="Courier New" Width="110" Height="40" Margin="120,100,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Impacto" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="Térmica" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <ComboBox x:Name="cboMarcaCocina" FontFamily="Courier New" Width="150" Height="40" Margin="243,100,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Epson" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="SAT" Height="40" VerticalContentAlignment="Center" />
                        <ComboBoxItem Content="ZKTeco" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <Label Content="Usa espacios:" Margin="405,100,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkEspCocina" Margin="500,100,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Label Content="Letras grandes:" Margin="550,100,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkBigCocina" Margin="640,100,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <Label Content="Para Parrilla: " Margin="5, 150, 0, 0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboTipoParrilla" FontFamily="Courier New" Width="110" Height="40" Margin="120,150,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Impacto" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="Térmica" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <ComboBox x:Name="cboMarcaParrilla" FontFamily="Courier New" Width="150" Height="40" Margin="243,150,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Epson" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="SAT" Height="40" VerticalContentAlignment="Center" />
                        <ComboBoxItem Content="ZKTeco" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <Label Content="Usa espacios:" Margin="405,150,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkEspParrilla" Margin="500,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Label Content="Letras grandes:" Margin="550,150,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkBigParrilla" Margin="640,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <Label Content="Para Bar: " Margin="5, 200, 0, 0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboTipoBar" FontFamily="Courier New" Width="110" Height="40" Margin="120,200,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Impacto" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="Térmica" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <ComboBox x:Name="cboMarcaBar" FontFamily="Courier New" Width="150" Height="40" Margin="243,200,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Epson" Height="40" VerticalContentAlignment="Center" IsSelected="True" />
                        <ComboBoxItem Content="SAT" Height="40" VerticalContentAlignment="Center" />
                        <ComboBoxItem Content="ZKTeco" Height="40" VerticalContentAlignment="Center" />
                    </ComboBox>
                    <Label Content="Usa espacios:" Margin="405,200,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkEspBar" Margin="500,200,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <Label Content="Letras grandes:" Margin="550,200,0,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkBigBar" Margin="640,200,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="15" Width="16">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="3" ScaleY="3" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                </Grid>
            </GroupBox>
        </Grid>
        <Grid DockPanel.Dock="Bottom" Height="60" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0, 0, 0, 0">
            <Button x:Name="btnGrabar" HorizontalAlignment="Center" Margin="-120,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Center" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </DockPanel>
</UserControl>
