<UserControl x:Class="TreskelRest.frms.ctls.ctlNotasCredito"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid>
        <Label x:Name="label" Content="Criterio:" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtCriterio" HorizontalAlignment="Left" Height="40" Margin="80,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="160"  FontSize="16" VerticalContentAlignment="Center" />
        <Label x:Name="label1" Content="Fecha:" HorizontalAlignment="Left" Margin="250,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <DatePicker x:Name="dtpDesde" Height="40" Width="180" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="310,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <DatePicker x:Name="dtpHasta" Height="40" Width="180" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="500,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Button x:Name="btnBuscar" Margin="690,10,0,0" Width="100" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Foreground="White" Click="btnBuscar_Click">
            <Button.Background>
                <SolidColorBrush Color="#5bc0de" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Buscar</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnNuevo" Margin="60,10,130,0" Width="110" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Foreground="White" Click="btnNuevo_Click"  >
            <Button.Background>
                <SolidColorBrush Color="#5cb85c" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/add.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Nuevo</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnSalir" Margin="60,10,10,0" Width="110" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Foreground="White" Click="btnSalir_Click">
            <Button.Background>
                <SolidColorBrush Color="#d9534f" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/cancel.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
            </StackPanel>
        </Button>
        <DataGrid x:Name="Resultado" Width="Auto" Height="Auto" Margin="0,70,0,0"
                      AlternationCount="2" AlternatingRowBackground="Aquamarine"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" 
                      CanUserReorderColumns="True" CanUserAddRows="False" IsReadOnly="True" RowHeight="50"
                      FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Acción" Width="70" Visibility="Hidden" >
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <Grid>
                                <Button Width="60" Height="40" Margin="3" Background="Transparent" BorderBrush="Transparent" Click="Editar_Click" >
                                    <Image Source="../../images/preview.png" Width="30" Height="30" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Código" Binding="{Binding ntcrscl}" Width="100" />
                <DataGridTextColumn Header="Sec. Venta" Binding="{Binding ventscl}" Width="100" />
                <DataGridTextColumn Header="Factura" Binding="{Binding numefac}" Width="160" />
                <DataGridTextColumn Header="Estado" Binding="{Binding etdonbr}" Width="140" />
                <!--<DataGridTextColumn Header="Motivo" Binding="{Binding ntcrmtv}" Width="110" />-->
                <DataGridTemplateColumn Header="Motivo" Width="60" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <Image Source="{Binding ntcrmti}" Width="33" Height="33">
                                <Image.ToolTip>
                                    <ToolTip Content="{Binding ntcrmtv}" />
                                </Image.ToolTip>
                            </Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate >
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Fecha" Binding="{Binding ntcrfch}" Width="100" />
                <DataGridTextColumn Header="ID Cliente" Binding="{Binding nidnid}" Width="130" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding nidnbr}" Width="250" />
            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</UserControl>
