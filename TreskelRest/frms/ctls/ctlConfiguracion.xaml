<UserControl             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"                           
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls" 
             xmlns:timepicker="clr-namespace:LibControls.timepicker;assembly=LibControls" 
             xmlns:switchButton="clr-namespace:LibControls.switchButton;assembly=LibControls" x:Class="TreskelRest.frms.ctls.ctlConfiguracion" 
             mc:Ignorable="d" Background="White"
             d:DesignHeight="650" d:DesignWidth="1150">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="60" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
            <ProgressBar x:Name="uploading" Height="45" VerticalAlignment="Top" Width="300" HorizontalAlignment="left" Margin="300,5,0,0" Visibility="Hidden" IsIndeterminate="True"/>
        </Grid>

        <Grid Height="Auto">
            <TabControl x:Name="tabControl" Width="Auto" Height="Auto" Margin="10,10,10,0" VerticalAlignment="Top">
                <TabItem Header="Generales" FontSize="16" Height="40" Margin="-2,0">
                    <Grid>
                        <TabControl Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="960" Height="400">
                            <TabItem Header="General" Height="40">
                                <Grid>
                                    <Label Content="Usa teclado en pantalla:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                    <CheckBox x:Name="chkTouch" Margin="200,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="3" ScaleY="3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <Label Content="Documentos a Generar:" FontSize="16" Height="40" Width="180" Margin="270,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                    <switchButton:ctlSwitchButton x:Name="DocuCrea" Height="50" Width="150" Margin="500,10,0,0" Colores="AzulBlanco" Forma="Cuadrado" isEnabled="True" texto="FACTURA" textoAlterno="NOTA DE VENTA" VerticalAlignment="Top" HorizontalAlignment="Left" Valores="F/N"/>

                                    <Label Content="Cierre Caja Acumulativo:" FontSize="16" Height="40" Width="200" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                    <CheckBox x:Name="chkCierreAcum" Margin="200,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="3" ScaleY="3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <Label Content="Formato de Decimales (Rpte):" FontSize="16" Height="40" Width="220" Margin="270,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <ComboBox x:Name="cboFormatDec" FontSize="16" Height="40" Width="200" Margin="500,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" SelectionChanged="cboFormatDec_SelectionChanged" Grid.Column="2" >
                                        <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="###,###.##" IsSelected="True" />
                                        <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="###.###,##" />
                                    </ComboBox>

                                    <Label Content="Ruc Empresa Desarrolladora del Sistema:" FontSize="16" Height="40" Width="300" Margin="10,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                                    <TextBox x:Name="txtRucDevelop" FontSize="16" Height="40" Width="200" Margin="320,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Text="" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Compras e Inventario" Height="40">
                                <Grid>
                                    <GroupBox Header="Inventario" Width="800" Height="100" Margin="10,10,10,10" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid>
                                            <Label Content="Controlar Inventario:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                            <CheckBox x:Name="chkCtrlInv" Margin="200,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="3" ScaleY="3" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <Label Content="Stock Mínimo:" FontSize="16" Height="40" Width="180" Margin="270,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                            <spinner:ctlSpinner x:Name="txtStockMin" HorizontalAlignment="Left" Margin="500,10,0,0" VerticalAlignment="Top" Grid.Column="2" Height="40" Width="160"/>
                                        </Grid>    
                                    </GroupBox>
                                    <GroupBox Header="Compras" Height="150" Width="800" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,120,10,10">
                                        <Grid>
                                            <Label Content="Incluir Precios:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                            <CheckBox x:Name="chkIncPrc" Margin="200,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16" IsChecked="True">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="3" ScaleY="3" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Precios" Height="40">
                                <Grid>
                                    <Label Content="Precios incluyen IVA:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                                    <CheckBox x:Name="chkPrcIva" Margin="210,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="3" ScaleY="3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <Label Content="Valor del IVA:" FontSize="16" Height="40" Width="180" Margin="270,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <spinner:ctlSpinner x:Name="txtIva" HorizontalAlignment="Left" Margin="420,10,0,0" VerticalAlignment="Top" Grid.Column="2" Height="40" Width="160"/>
                                    <Label Content="Usa Descuentos manuales:" FontSize="16" Height="40" Width="200" Margin="10,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <CheckBox x:Name="chkDsctManual" Margin="210,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="3" ScaleY="3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                    <Label Content="Valor IVA Feriado:" FontSize="16" Height="40" Width="180" Margin="270,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <spinner:ctlSpinner x:Name="txtIvaFeriado" HorizontalAlignment="Left" Margin="420,60,0,0" VerticalAlignment="Top" Grid.Column="2" Height="40" Width="160"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Crédito" Height="40">
                                <Grid>
                                    <GroupBox Header="Opciones de Crédito" Margin="10, 10, 10,10" Width="370" Height="150" BorderThickness="2" BorderBrush="Black" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid>
                                            <Label Content="Permite dar çrédito:" FontSize="16" Height="40" Width="220" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                            <CheckBox x:Name="chkAllowCredito" Margin="200,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="chkAllowProforma_Checked" Unchecked="chkAllowProforma_Unchecked" Grid.Column="2" Height="15" Width="16">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="3" ScaleY="3" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>

                                            <Label Content="Corte para los créditos:" FontSize="16" Height="40" Width="220" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                            <ComboBox x:Name="cboTiempoCorte" FontSize="16" Height="40" Width="150" Margin="200,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" SelectionChanged="cboFormatDec_SelectionChanged" Grid.Column="2" >
                                                <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="Quincenal" IsSelected="True" />
                                                <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="Mensual" />
                                            </ComboBox>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Reportes" Height="40">
                                <WrapPanel Orientation="Horizontal" x:Name="tabTemas">
                                    <WrapPanel.Resources>
                                        <Style TargetType="{x:Type ToggleButton}">
                                            <Setter Property="Margin" Value="10" />
                                        </Style>
                                    </WrapPanel.Resources>
                                    <ToggleButton x:Name="tema0" Tag="-1" Width="150" Height="120" IsChecked="True" Style="{StaticResource styleToggleTheme}" >
                                        <Image Source="/images/tema0.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema1" Tag="0" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema1.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema2" Tag="1" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema2.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema3" Tag="2" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema3.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema4" Tag="3" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema4.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema5" Tag="4" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema5.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema6" Tag="5" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema6.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema7" Tag="6" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema7.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema8" Tag="7" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema8.png" Width="130" />
                                    </ToggleButton>
                                    <ToggleButton x:Name="tema9" Tag="8" Width="150" Height="120" Style="{StaticResource styleToggleTheme}">
                                        <Image Source="/images/tema9.png" Width="130" />
                                    </ToggleButton>
                                </WrapPanel>
                            </TabItem>
                            <TabItem Header="Presentación Login" Height="40">
                                <Grid>
                                    <Label Content="Fondo aleatorio :" FontSize="16" Height="40" Width="220" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <CheckBox x:Name="chkFondoRandom" Margin="200,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="chkAllowProforma_Checked" Unchecked="chkAllowProforma_Unchecked" Grid.Column="2" Height="15" Width="16">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="3" ScaleY="3" />
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>

                                    <Label Content="Tema :" FontSize="16" Height="40" Width="220" Margin="300,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.Column="2" />
                                    <ComboBox x:Name="cboTemaLogin" FontSize="16" Height="40" Width="200" Margin="370,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" SelectionChanged="cboTemaLogin_SelectionChanged" Grid.Column="2" >
                                        <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="Restaurante" IsSelected="True" />
                                        <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="Musical" />
                                        <ComboBoxItem Height="60" VerticalContentAlignment="Center" Content="Software" />
                                    </ComboBox>
                                    <GroupBox Header="Fondos disponibles" Margin="10,60,10,10" Height="280" VerticalAlignment="Top">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="255" CanContentScroll="True" >
                                            <ScrollViewer.Resources>
                                                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                                                    <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Orientation" Value="Horizontal">
                                                            <Setter Property="Height" Value="30" />
                                                            <Setter Property="MinHeight" Value="30" />
                                                        </Trigger>
                                                        <Trigger Property="Orientation" Value="Vertical">
                                                            <Setter Property="Width" Value="30" />
                                                            <Setter Property="MinWidth" Value="30" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Resources>
                                            <WrapPanel FlowDirection="LeftToRight" Margin="0,3,0,3" VerticalAlignment="Top" Orientation="Horizontal">
                                                <WrapPanel.Resources>
                                                    <Style TargetType="{x:Type Button}">
                                                        <Setter Property="Margin" Value="1"/>
                                                    </Style>
                                                </WrapPanel.Resources>

                                                <RadioButton x:Name="Fondo1" Width="160" Height="100" Style="{StaticResource styleRadioToggleTheme}" IsChecked="True" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo1" Source="../../images/fondo.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="Fondo2" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo2" Source="../../images/fondo2.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="Fondo3" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo3" Source="../../images/fondo3.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo4" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo4" Source="../../images/fondo4.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo5" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo5" Source="../../images/fondo5.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo6" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo6" Source="../../images/fondo6.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo7" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo7" Source="../../images/fondo7.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo8" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo8" Source="../../images/fondo8.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo9" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo9" Source="../../images/fondo9.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>

                                                <RadioButton x:Name="Fondo10" Width="160"  Height="100" Style="{StaticResource styleRadioToggleTheme}" Checked="Fondo_Checked" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel.Resources>
                                                            <Style TargetType="{x:Type Image}">
                                                                <Setter Property="Margin" Value="3"/>
                                                            </Style>
                                                        </StackPanel.Resources>
                                                        <Image x:Name="imgFondo10" Source="../../images/fondo10.png" Width="140" Height="80" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </WrapPanel>
                                        </ScrollViewer>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
                <TabItem Header=" Mesas " FontSize="16" Height="40">
                    <Grid>
                        <Label Content="Sala Principal:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtMesas" HorizontalAlignment="Left" Margin="130,10,0,0" VerticalAlignment="Top"/>
                        <Label Content="Sala alterna:" FontSize="16" Height="40" Width="100" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="2" />
                        <CheckBox x:Name="chkAlterna" Margin="120,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Checked="chkAlterna_Checked" Unchecked="chkAlterna_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Cantidad Sala Alterna:" FontSize="16" Height="40" Width="180" Margin="180,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtMesasAlt" HorizontalAlignment="Left" Margin="370,70,0,0" VerticalAlignment="Top" IsEnabled="False"/>

                        <Label Content="Exterior:" FontSize="16" Height="40" Width="100" Margin="10,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="2" />
                        <CheckBox x:Name="chkExterior" Margin="120,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Checked="chkExterior_Checked" Unchecked="chkExterior_Unchecked" RenderTransformOrigin="1.5,1.5">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Cantidad Exterior:" FontSize="16" Height="40" Width="180" Margin="180,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtMesasExt" HorizontalAlignment="Left" Margin="370,130,0,0" VerticalAlignment="Top" IsEnabled="False"/>

                        <Label Content="Terraza:" FontSize="16" Height="40" Width="100" Margin="10,190,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="2" />
                        <CheckBox x:Name="chkTerraza" Margin="120,190,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Checked="chkTerraza_Checked" Unchecked="chkTerraza_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Cantidad Terraza:" FontSize="16" Height="40" Width="180" Margin="180,190,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtMesasTerr" HorizontalAlignment="Left" Margin="370,190,0,0" VerticalAlignment="Top" IsEnabled="False"/>

                        <Label Content="2do Piso:" FontSize="16" Height="40" Width="100" Margin="10,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="2" />
                        <CheckBox x:Name="chk2Piso" Margin="120,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="1" Checked="chk2Piso_Checked" Unchecked="chk2Piso_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Cantidad 2do Piso:" FontSize="16" Height="40" Width="180" Margin="180,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtMesasSPis" HorizontalAlignment="Left" Margin="370,250,0,0" VerticalAlignment="Top" IsEnabled="False"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Pedidos y Ventas" FontSize="16" Height="40" VerticalAlignment="Bottom">
                    <Grid Height="Auto">
                        <TabControl Margin="10,10,10,10" Width="1000" Height="500" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TabItem Header="Diseño" Height="40">
                                <Grid>
