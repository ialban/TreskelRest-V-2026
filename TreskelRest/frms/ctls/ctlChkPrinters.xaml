<UserControl x:Class="TreskelRest.frms.ctls.ctlChkPrinters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image x:Name="PrnCocina" HorizontalAlignment="Left" Source="../../images/printerOnLine.png" Height="129" Margin="20,46,0,0" VerticalAlignment="Top" Width="132"/>
        <Image x:Name="PrnParrilla" HorizontalAlignment="Left" Source="/TreskelRest;component/images/printerOnLine.png" Height="129" Margin="400,46,0,0" VerticalAlignment="Top" Width="132"/>
        <Image x:Name="PrnFactura" HorizontalAlignment="Left" Source="/TreskelRest;component/images/printerOnLine.png" Height="129" Margin="20,225,0,0" VerticalAlignment="Top" Width="132"/>
        <Image x:Name="PrnProforma" HorizontalAlignment="Left" Source="/TreskelRest;component/images/printerOnLine.png" Height="129" Margin="400,225,0,0" VerticalAlignment="Top" Width="132"/>
        
        <Button x:Name="btnCancelar" HorizontalAlignment="center" Margin="0,0,0,10" VerticalAlignment="Bottom" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="/TreskelRest;component/images/cancel.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
            </StackPanel>
        </Button>
        
        <Label Content="Impresora de cocina" FontSize="18" HorizontalAlignment="Left" Margin="170,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Impresora de Parrilla" FontSize="18" HorizontalAlignment="Left" Margin="560,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Impresora de Facturación" FontSize="18" HorizontalAlignment="Left" Margin="170,260,0,0" VerticalAlignment="Top"/>
        <Label Content="Impresora de Proformas" FontSize="18" HorizontalAlignment="Left" Margin="560,260,0,0" VerticalAlignment="Top"/>

    </Grid>
</UserControl>
