<UserControl x:Class="TreskelRest.frms.ctls.ctlTestEmail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid>
        <Label Content="Servidor smtp:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtServer" FontSize="16" Height="40" Width="500" Margin="150,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <Label Content="Puerto smtp:" FontSize="16" Height="40" Width="180" Margin="10,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtPuerto" FontSize="16" Height="40" Width="150" Margin="150,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" MaxLength="5"  />
        <Label Content="Usa TLS:" FontSize="16" Height="40" Width="180" Margin="350,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <CheckBox x:Name="chkTls" Margin="450,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" >
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Label Content="Usuario:" FontSize="16" Height="40" Width="180" Margin="10,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtUsuario" FontSize="16" Height="40" Width="200" Margin="150,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" MaxLength="100" />
        <Label Content="Contraseña:" FontSize="16" Height="40" Width="180" Margin="350,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <PasswordBox x:Name="txtClave" FontSize="16" Height="40" Width="200" Margin="450,110,10,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" MaxLength="50"  />

        <Label Content="Correo principal:" FontSize="16" Height="40" Width="180" Margin="10,160,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtCorreo1" FontSize="16" Height="40" Width="390" Margin="150,160,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" MaxLength="100" />

        <Label Content="Mensaje:" FontSize="16" Height="40" Width="180" Margin="10,210,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtMensaje" FontSize="16" Height="40" Width="500" Margin="150,210,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" MaxLength="100" />

        <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,300,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="Black" FontSize="16" Click="btnGrabar_Click" Background="LightGreen">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/send.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center"><Run Text="Enviar"/></TextBlock>
            </StackPanel>
        </Button>

        <Button x:Name="btnEnviar" HorizontalAlignment="Left" Margin="200,300,0,0" VerticalAlignment="Top" Width="150" Height="40" Foreground="Black" FontSize="16" Click="btnEnviar_Click" Background="LightGreen">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/send.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center"><Run Text="Enviar via API"/></TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
