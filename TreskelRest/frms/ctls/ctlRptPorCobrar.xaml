<UserControl x:Class="TreskelRest.frms.ctls.ctlRptPorCobrar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="60" HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb51a" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/process.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Generar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <Grid>
            <GroupBox Header="Rango de Fecha" Margin="10, 10, 10, 0" Width="780" Height="130" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid>
                    <Label Content="Inicio:" FontSize="16" Width="50" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <DatePicker x:Name="desde" FontSize="16" Width="350" Height="40" Margin="100,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />

                    <Label Content="Fin:" FontSize="16" Width="50" Height="40" Margin="10,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <DatePicker x:Name="hasta" FontSize="16" Width="350" Height="40" Margin="100,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Datos del Clliente" Margin="10, 150, 0, 0" Width="780" Height="230" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid>
                    <RadioButton x:Name="PorCliente" Content="Por Cliente" Margin="10, 10, 0, 0" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="PorCliente_Checked">
                        <RadioButton.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                        </RadioButton.LayoutTransform>
                    </RadioButton>
                    <RadioButton x:Name="PorEmpresa" Content="Por Empresa" Margin="200, 10, 0, 0" IsChecked="True" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="PorEmpresa_Checked">
                        <RadioButton.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                        </RadioButton.LayoutTransform>
                    </RadioButton>
                    <RadioButton x:Name="ConsolidadoClientes" Content="Consolidado Clientes" Margin="400, 10, 0, 0" VerticalAlignment="Top" HorizontalAlignment="Left" Checked="ConsolidadoClientes_Checked">
                        <RadioButton.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                        </RadioButton.LayoutTransform>
                    </RadioButton>


                    <Label Content="Cliente:" FontSize="16" Width="100" Height="40" Margin="10,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <ComboBox x:Name="cboCliente" FontSize="16" Height="40" Width="507" VerticalAlignment="Top"  SelectedValuePath="Tag"
                          HorizontalAlignment="Left" Margin="100,60,0,0">

                    </ComboBox>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
