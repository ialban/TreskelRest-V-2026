<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls"
             xmlns:checkbox="clr-namespace:LibControls.checkbox;assembly=LibControls" x:Class="TreskelRest.frms.ctls.ctlReporteAnulaciones"
             mc:Ignorable="d" Background="White" Width="600" Height="308">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Height="60" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb51a">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/process.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center"><Run Text="Generar"/></TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <Label Content="Facturas Electrónicas" FontSize="16" Width="160" Height="40" Margin="10,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                <checkbox:ctlCheckBox x:Name="FactElect" HorizontalAlignment="Left" Height="40" Margin="170,5,0,-31" VerticalAlignment="Top" Width="100" ctlChecked="FactElect_ctlChecked" ctlUnChecked="FactElect_ctlUnChecked"/>
                <GroupBox x:Name="FE" Margin="0,50,0,0" Header="Criterio para Facturas Electrónicas" Height="75" VerticalAlignment="Top">
                    <Grid>
                        <DatePicker x:Name="fecha" FontSize="16" Width="350" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />
                    </Grid>
                </GroupBox>
                <GroupBox x:Name="NoFE" Header="Criterio para Facturas no Electrónicas" Margin="0,130,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Label Content="Año" FontSize="16" Width="50" Height="40" Margin="10,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtAnio" HorizontalAlignment="Left" Margin="100,5,0,0" VerticalAlignment="Top"/>
                        <Label Content="Mes" FontSize="16" Width="50" Height="40" Margin="10,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <ComboBox x:Name="cboMes" FontSize="16" Width="350" Height="40" Margin="100,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                            <ComboBoxItem Tag="" Height="50" VerticalContentAlignment="Center" Content="-- Seleccione un Mes --"/>
                            <ComboBoxItem Tag="1" Height="40" VerticalContentAlignment="Center" Content="Enero"/>
                            <ComboBoxItem Tag="2" Height="40" VerticalContentAlignment="Center" Content="Febrero"/>
                            <ComboBoxItem Tag="3" Height="40" VerticalContentAlignment="Center" Content="Marzo"/>
                            <ComboBoxItem Tag="4" Height="40" VerticalContentAlignment="Center" Content="Abril"/>
                            <ComboBoxItem Tag="5" Height="40" VerticalContentAlignment="Center" Content="Mayo"/>
                            <ComboBoxItem Tag="6" Height="40" VerticalContentAlignment="Center" Content="Junio"/>
                            <ComboBoxItem Tag="7" Height="40" VerticalContentAlignment="Center" Content="Julio"/>
                            <ComboBoxItem Tag="8" Height="40" VerticalContentAlignment="Center" Content="Agosto"/>
                            <ComboBoxItem Tag="9" Height="40" VerticalContentAlignment="Center" Content="Septiembre"/>
                            <ComboBoxItem Tag="10" Height="40" VerticalContentAlignment="Center" Content="Octubre"/>
                            <ComboBoxItem Tag="11" Height="40" VerticalContentAlignment="Center" Content="Noviembre"/>
                            <ComboBoxItem Tag="12" Height="40" VerticalContentAlignment="Center" Content="Diciembre"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>
                
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
