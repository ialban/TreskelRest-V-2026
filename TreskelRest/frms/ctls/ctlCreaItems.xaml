        <imageUploader:ctlImageUploader x:Name="imgUploader" HorizontalAlignment="Left" Width="185" Height="230" Margin="750,20,0,0" VerticalAlignment="Top" _ctlImageUploader="imgUploader__ctlImageUploader" />
        
        <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,522,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
            <Button.Background>
                <SolidColorBrush Color="#5cb85c" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/save.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="153,522,0,0" VerticalAlignment="Top" Width="112" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
            <Button.Background>
                <SolidColorBrush Color="#d9534f" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/cancel.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
            </StackPanel>
        </Button>
        <GroupBox Header="Relación con Materia Prima" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" Height="170" Margin="208,320,0,0" VerticalAlignment="Top" Width="500" BorderBrush="Black">
            <StackPanel HorizontalAlignment="Left" Margin="10,10,-2,-18" Width="480">
                <TextBlock Height="40" FontSize="16" Margin="10,10,10,0" TextWrapping="WrapWithOverflow" FontWeight="Normal" TextAlignment="Justify" >
                    "Seleccione el producto con el cual se relaciona en el inventario, aplica únicamente a productos finales."
                </TextBlock>
                <TextBlock FontSize="16" Margin="10,10,0,0" FontWeight="Normal">                                        
                    <Label Content="Materia Prima" Height="40" FontSize="16" VerticalContentAlignment="Center" Margin="0,10,0,0" />
                    <ComboBox x:Name="cboMPrima" FontSize="16" Height="40" Width="336" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" />
                </TextBlock>
            </StackPanel>
        </GroupBox>
        <Label Content="Producto para:" Height="40" FontSize="16" VerticalContentAlignment="Center" Margin="750,260,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <ComboBox x:Name="cboDestino" FontSize="16" Height="40" Width="180" Margin="750,300,0,0" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem Content="Todos" VerticalContentAlignment="Center" Height="40" IsSelected="True" />
            <ComboBoxItem Content="Restaurant" VerticalContentAlignment="Center" Height="40" />
            <ComboBoxItem Content="Market" VerticalContentAlignment="Center"  Height="40" />
        </ComboBox>
        <!--
        <Label Content="Materia Prima : " HorizontalAlignment="Left" Margin="299,270,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cboMateria" HorizontalAlignment="Left" Margin="462,270,0,0" VerticalAlignment="Top" Width="246" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        -->
    </Grid>
</UserControl>
