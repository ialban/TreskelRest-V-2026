<UserControl x:Class="TreskelRest.frms.ctls.ctlImportacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TextBlock Margin="10,10,10,5" Height="40" VerticalAlignment="Top" TextWrapping="Wrap">Se va a proceder a importar datos, antes de iniciar, asegurese de que los archivos de excel,
        cumplen con el formato adecuado, de acuerdo con la data a generar, el (los) archivos deben estar en formato CSV.</TextBlock>
        <Label Content="Separador:" Margin="5,50,5,5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="40" VerticalContentAlignment="Center" />
        <ComboBox x:Name="cboSeparador" Margin="90,50,5,5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="40" Width="100" VerticalContentAlignment="Center">
            <ComboBoxItem Content=", (Coma)" IsSelected="True" Height="40"  VerticalContentAlignment="Center" />
            <ComboBoxItem Content="; (Punto y Coma)" IsSelected="false" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Content="Tabulador" IsSelected="false" Height="40" VerticalContentAlignment="Center" />
        </ComboBox>
        <Label Content="Contiene cabecera:" Margin="200,50,5,5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="40" VerticalContentAlignment="Center" />
        <CheckBox x:Name="chkUseHead" Margin="315,47,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsChecked="True">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <GroupBox Header="Importación de Items para venta" Margin="10,100,10,0" Height="100" VerticalAlignment="Top">
            <Grid>
                <Label Content="Seleccionar archivo:" Margin="5,5,5,0" Width="200" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <TextBox x:Name="txtItems" FontSize="14" Margin="5,30,5,0" Width="500" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Left" IsReadOnly="True"></TextBox>
                <Button x:Name="btnItems" Margin="505,30,5,0" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Click="btnItems_Click">
                    <Image Source="../../images/excel.png" Width="33" Height="33" />
                </Button>
                <Button x:Name="btnItemsInfo" Margin="550,30,5,0" Background="LightBlue" Width="40" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Click="btnItemsInfo_Click">
                    <Image Source="../../images/info.png" Width="33" Height="33" />
                </Button>
            </Grid>
        </GroupBox>
        <Grid HorizontalAlignment="Center" Margin="0,0,0,10" VerticalAlignment="Bottom" Height="50">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,5,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/play.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Importar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,5,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
