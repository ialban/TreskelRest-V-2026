<UserControl xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls"  
             x:Class="TreskelRest.frms.ctls.ctlCreaEmpleado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" d:DesignWidth="840" Height="530">
    <Grid>
        <Label x:Name="label" Content="Tipo de Documento : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <ComboBox x:Name="cboTipo" HorizontalAlignment="Left" Margin="178,10,0,0" VerticalAlignment="Top" Width="120" Height="40" VerticalContentAlignment="Center" FontSize="16">
            <ComboBoxItem Tag="C" IsSelected="True" Content="Cédula" />
            <ComboBoxItem Tag="P" Content="Pasaporte" />
        </ComboBox>
        <Label x:Name="label1" Content="Num. Identificación : " HorizontalAlignment="Left" Margin="314,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="478,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Label x:Name="label2" Content="Nombres : " HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtNombre" HorizontalAlignment="Left" Margin="116,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="300" MaxLength="50" FontSize="16" Height="40" VerticalContentAlignment="Center"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps" />
        <Label x:Name="label3" Content="Apellidos : " HorizontalAlignment="Left" Margin="430,73,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtApellido" HorizontalAlignment="Left" Height="40" Margin="520,73,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="300" FontSize="16" VerticalContentAlignment="Center" MaxLength="50" CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
        <Label x:Name="label4" Content="Dirección : " HorizontalAlignment="Left" Margin="9,136,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <Label VerticalAlignment="Top" HorizontalAlignment="Left" Margin="116, 136, 0, 0" Background="#0076C0">
            <Image Source="../../images/location.png" Width="30" Height="30"  />
        </Label>
        <TextBox x:Name="txtDireccion" HorizontalAlignment="Left" Height="40" Margin="156,136,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="665" FontSize="16" VerticalContentAlignment="Center" MaxLength="100" CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
        <Label x:Name="labelSal" Content="Salario : " HorizontalAlignment="Left" Margin="9,193,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <Label HorizontalAlignment="Left" Margin="116,193,0,0" VerticalAlignment="Top" FontSize="16" 
               VerticalContentAlignment="Center" Height="40" 
               BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White">
            <Image Source="../../images/cash.png" Width="30" Height="30"  />
        </Label>
        <TextBox x:Name="txtSalario" HorizontalAlignment="Left" Height="40" Margin="158,193,0,0" Text="0.00" 
                 VerticalAlignment="Top" Width="120" FontSize="16" VerticalContentAlignment="Center" MaxLength="10"/>
        <GroupBox x:Name="groupBox" Header="Teléfonos" HorizontalAlignment="Left" Height="92" Margin="10,248,0,0" VerticalAlignment="Top" Width="810" FontSize="16">
            <Grid Margin="0,0,0,0">
                <Label Content="Convencional : " HorizontalAlignment="Left" Margin="9,9,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
                <Label Content="Celular : " HorizontalAlignment="Left" Margin="370,9,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
                <Label VerticalAlignment="Top" HorizontalAlignment="Left" Margin="126, 10, 0, 0" Background="#0076C0">
                    <Image Source="../../images/telefono.png" Width="30" Height="30"  />
                </Label>
                <TextBox x:Name="txtTfl" HorizontalAlignment="Left" Height="40" Margin="165,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="190" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
                <Label VerticalAlignment="Top" HorizontalAlignment="Left" Margin="446, 10, 0, 0" Background="#0076C0">
                    <Image Source="../../images/movil.png" Width="30" Height="30"  />
                </Label>
                <TextBox x:Name="txtCel" HorizontalAlignment="Left" Height="40" Margin="485,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="190" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
            </Grid>
        </GroupBox>
        <Label x:Name="label5" Content="Nació en : " HorizontalAlignment="Left" Margin="9,361,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <DatePicker x:Name="dtpFecha" HorizontalAlignment="Left" Margin="116,361,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center" Width="182">
            <DatePicker.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <TextBox Text="{Binding Path=SelectedDate, StringFormat='yyyy-MM-dd', 
                                        RelativeSource={RelativeSource AncestorType={x:Type DatePicker}}}" BorderBrush="Transparent" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="Calendar">
                    <Setter Property="CalendarDayButtonStyle">
                        <Setter.Value>
                            <Style TargetType="CalendarDayButton" BasedOn="{StaticResource {x:Type CalendarDayButton}}">
                                <Setter Property="FontSize" Value="20" />
                            </Style>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DatePicker.Resources>
        </DatePicker>
        <Label x:Name="label6" Content="Cantidad Hijos : " HorizontalAlignment="Left" Margin="323,361,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <Label x:Name="label7" Content="Activo : " HorizontalAlignment="Left" Margin="9,419,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.1,0.312" FontSize="16" Height="40" VerticalContentAlignment="Center" />
        <CheckBox x:Name="chkEstado" HorizontalAlignment="Left" Margin="113,421,0,0" VerticalAlignment="Top" IsChecked="True">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <spinner:ctlSpinner x:Name="txtHijos" Height="40" Width="170" Margin="453,361,87,129"/>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="60">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
