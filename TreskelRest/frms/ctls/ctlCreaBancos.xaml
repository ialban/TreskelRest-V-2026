<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaBancos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="810">
    <Grid>
        <Label Content="Seleccione el Banco:" FontSize="16" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Grid x:Name="lsBancos" Margin ="10,45,0,0" Width="390" Height="300" VerticalAlignment="Top" HorizontalAlignment="Left">
            <StackPanel Orientation="Vertical" Margin="10, 10, 0, 0">
                <StackPanel x:Name="contBancos1" Orientation="Horizontal" DockPanel.Dock="Top" Height="70" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </StackPanel.Resources>
                    <ToggleButton x:Name="BcoGquil" Tag="BG" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bgquil.png" Width="30" Height="30" />
                            <Label Content="Guayaquil" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoPichincha" Tag="BP" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bpichincha.png" Width="30" Height="30" />
                            <Label Content="Pichincha" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoBolivariano" Tag="BB" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bbolivariano.png" Width="30" Height="30" />
                            <Label Content="Bolivariano" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoPacifico" Tag="PB" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bpacifico.png" Width="30" Height="30" />
                            <Label Content="Pacífico" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MutPichincha" Tag="MP" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/mutPichincha.png" Width="30" Height="30" />
                            <Label Content="M. Pichincha" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="contBancos2" Orientation="Horizontal" DockPanel.Dock="Top" Height="70" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </StackPanel.Resources>
                    <ToggleButton x:Name="BcoProdubanco" Tag="BD" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/produbanco.png" Width="30" Height="30" />
                            <Label Content="Produbanco" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoInternacional" Tag="BI" Background="WhiteSmoke" Width="70" Height="60"  Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/binternacional.png" Width="30" Height="30" />
                            <Label Content="Internacional" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoAustro" Tag="BA" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/baustro.png" Width="30" Height="30" />
                            <Label Content="Austro" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoMachala" Tag="BM" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bmachala.png" Width="30" Height="30" />
                            <Label Content="Machala" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="MAmbato" Tag="MA" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/mutAmbato.png" Width="30" Height="30" />
                            <Label Content="M.Ambato" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="contBancos3" Orientation="Horizontal" DockPanel.Dock="Top" Height="70" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </StackPanel.Resources>
                    <ToggleButton x:Name="BcoSolidario" Tag="BS" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bsolidario.png" Width="30" Height="30" />
                            <Label Content="Solidario" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BcoRuminahui" Tag="BR" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/bruminahui.png" Width="30" Height="30" />
                            <Label Content="Rumiñahui" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="CoopPN" Tag="CP" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/coopPN.png" Width="30" Height="30" />
                            <Label Content="C.Policia N" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="CoopOscus" Tag="CO" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/coopOscus.png" Width="30" Height="30" />
                            <Label Content="Oscus" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="CoopJep" Tag="CJ" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/coopJep.png" Width="30" Height="30" />
                            <Label Content="C. JEP" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
                <StackPanel x:Name="contBancos4" Orientation="Horizontal" DockPanel.Dock="Top" Height="70" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </StackPanel.Resources>
                    <ToggleButton x:Name="Coop29" Tag="29" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/coop29Oct.png" Width="30" Height="30" />
                            <Label Content="C.29 Oct" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="BanEc" Tag="BE" Background="WhiteSmoke" Width="70" Height="60" Checked="Banco_Checked" Unchecked="Banco_Unchecked">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/banEcuador.png" Width="30" Height="30" />
                            <Label Content="B.Ecuador" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Label Content="Número de Cuenta:" FontSize="16" Height="40" Margin="410,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <TextBox x:Name="txtCuenta" Text="" Tag="0" Margin="410,60,0,0" FontSize="16" Width="300" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
        <Button x:Name="btnCls" HorizontalAlignment="Left" Margin="715,60,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnCls_Click">
            <Button.Background>
                <SolidColorBrush Color="LightCyan" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/clear.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

        <GroupBox Margin="410, 110, 0, 0" Width="380" Height="80" Header="Tipo de Cuenta" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid>
                <Label Content="Corriente" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbCorriente" Margin="110,10,0,0" GroupName="tipos" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Checked="SeleccionTipoCuenta_Checked" IsChecked="True">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>

                <Label Content="Ahorro" HorizontalAlignment="Left" Margin="160,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbAhorro" Margin="230,10,0,0" GroupName="tipos" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Checked="SeleccionTipoCuenta_Checked">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>
            </Grid>
        </GroupBox>

        <GroupBox Margin="410, 200, 0, 0" Width="380" Height="80" Header="Propósito de la Cuenta" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid>
                <Label Content="Institucional" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbInstitucional" Margin="110,10,0,0" GroupName="motivos" VerticalAlignment="Top" HorizontalAlignment="Left"  
                             Checked="SeleccionMotivo_Checked" IsChecked="True">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>

                <Label Content="Personal" HorizontalAlignment="Left" Margin="160,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbPersonal" Margin="230,10,0,0" GroupName="motivos" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Checked="SeleccionMotivo_Checked">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>
            </Grid>
        </GroupBox>

        <Label Content="Es cuenta primaria :" HorizontalAlignment="Left" Margin="410,290,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <CheckBox x:Name="chkPrimaria" Margin="570,290,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16" IsChecked="True">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Label Content="Cuenta activa :" HorizontalAlignment="Left" Margin="410,340,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <CheckBox x:Name="chkActivo" Margin="570,340,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16" IsChecked="True">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Grid Margin="0,10,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="60" Width="280">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
