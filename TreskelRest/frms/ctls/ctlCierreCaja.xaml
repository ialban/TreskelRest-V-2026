<UserControl x:Class="TreskelRest.frms.ctls.ctlCierreCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" Width="712" Height="405">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="70" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid>
            <Label Content="Fecha" VerticalAlignment="Top" Height="40" Width="100" FontSize="16" FontWeight="Bold" Margin="10,10,0,0" HorizontalAlignment="Left"></Label>
            <Label Content="Hora" VerticalAlignment="Top" Height="40" Width="100" FontSize="16" FontWeight="Bold" Margin="320,10,0,0" HorizontalAlignment="Left"></Label>
            <Border BorderThickness="1" BorderBrush="Black" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="395,10,0,0">
                <Grid>
                    <TextBlock x:Name="hinicio" Padding="7" VerticalAlignment="Top" Height="40" Width="110" FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left">
                        00:00
                    </TextBlock>
                    <ToggleButton x:Name="selector" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Right" 
                            Margin="0,3,5,5" Background="Transparent" BorderBrush="Transparent" >
                        <Image Source="../../images/clock.png" Width="25" Height="25" />
                    </ToggleButton>
                    <Popup x:Name="popupControl" IsOpen="{Binding IsChecked ,ElementName=selector}" StaysOpen="false" Width="270">
                        <Border Background="LightYellow">
                            <DockPanel>
                                <DockPanel.Resources>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="3" />
                                    </Style>
                                </DockPanel.Resources>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Button x:Name="hInicioOk" Width="60" Height="50" Background="DarkBlue" Click="hInicioOk_Click">
                                        <Image Source="../../images/clock-white.png" Width="30" Height="30" />
                                    </Button>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <StackPanel Orientation="Vertical">
                                        <Slider x:Name="sHora" Width="50" Height="140" Orientation="Vertical" Value="0" Maximum="23" TickPlacement="Both" IsSnapToTickEnabled="True" ValueChanged="sHora_ValueChanged" />
                                        <Label Content="Hora" />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical">
                                        <Slider x:Name="sMinuto" Width="50" Height="140" Orientation="Vertical" Value="0" Maximum="59" TickPlacement="Both" IsSnapToTickEnabled="True" ValueChanged="sMinuto_ValueChanged"  />
                                        <Label Content="Minuto" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel.Resources>
                                        <Style TargetType="Button">
                                            <Setter Property="Margin" Value="6"></Setter>
                                        </Style>
                                    </StackPanel.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="horaUp" Width="55" Height="50" Background="LightBlue" Click="horaUp_Click">
                                            <Image Source="../../images/chevronup.png" Width="30" Height="30" />
                                        </Button>
                                        <Button x:Name="MinutoUp" Width="55" Height="50" Background="LightBlue" Click="MinutoUp_Click">
                                            <Image Source="../../images/chevronup.png" Width="30" Height="30" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label x:Name="lHora" Content="00" FontSize="18" Width="60" HorizontalContentAlignment="Center"></Label>
                                        <Label Content=":" FontSize="22"></Label>
                                        <Label x:Name="lMinuto" Content="00" FontSize="22" Width="60" HorizontalContentAlignment="Center"></Label>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="horaDown" Width="55" Height="50" Background="LightBlue" Click="horaDown_Click">
                                            <Image Source="../../images/chevrondown.png" Width="30" Height="30" />
                                        </Button>
                                        <Button x:Name="MinutoDown" Width="55" Height="50" Background="LightBlue" Click="MinutoDown_Click">
                                            <Image Source="../../images/chevrondown.png" Width="30" Height="30" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <DatePicker x:Name="dtpFecha" Height="40" Width="180" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="115,10,0,0" VerticalAlignment="Top" 
                        HorizontalAlignment="Left" SelectedDateChanged="dtpFecha_SelectedDateChanged"/>
            <Label Content="Caja" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,68,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
            <Label x:Name="lblCaja" Content="" Height="40" Width="430" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Margin="115,68,0,0" Background="LightGray"></Label>

            <GroupBox x:Name="groupBox" Header="Detalle" FontSize="14" FontWeight="Bold" HorizontalAlignment="Left" Height="201" Margin="10,124,0,0" VerticalAlignment="Top" Width="692">
                <Grid>
                    <Label Content="Inicio" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Inicio" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="90,10,0,0" />

                    <Label Content="Efectivo" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Efectivo" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="90,60,0,0" LostFocus="ActualizaValores_LostFocus" />

                    <Label Content="Tarjeta" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="230,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Tarjeta" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="320,60,0,0" LostFocus="ActualizaValores_LostFocus" />

                    <Label Content="Delivery" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="450,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Delivery" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="550,60,0,0" LostFocus="ActualizaValores_LostFocus" />

                    <Label Content="Cheque" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Cheque" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="90,110,0,0" LostFocus="ActualizaValores_LostFocus" />

                    <Label Content="Transferencia" Height="40" Width="110" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="210, 110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Transfer" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="320,110,0,0" LostFocus="ActualizaValores_LostFocus" />

                    <Label Content="Cierre" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="450,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
                    <TextBox x:Name="Cierre" Height="40" Width="120" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="550,110,0,0" LostFocus="Cierre_LostFocus" IsReadOnly="True" Background="#EEE9E8" />

                    <Label Content="Cierre Sistema" Height="40" Width="130" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="280,60,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Hidden" />
                    <TextBox x:Name="Sistema" Height="40" Width="150" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="420,60,0,0" Visibility="Hidden" />
                    <Label Content="Diferencia" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="Hidden" />
                    <TextBox x:Name="Diferencia" Height="40" Width="150" FontSize="16" FontWeight="Normal" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="120,120,0,0" Visibility="Hidden" />
                    <Button x:Name="Imprimir" Margin="460,10,0,0" Width="210" Height="40" VerticalAlignment="Top" 
                                HorizontalAlignment="Left" Visibility="Visible" Click="Imprimir_Click">
                        <Button.Background>
                            <SolidColorBrush Color="LightGreen" />
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                            </StackPanel.Resources>
                            <Image Source="../../images/printer.png" Width="30" Height="30" />
                            <TextBlock x:Name="ImpTicket" FontWeight="Normal" VerticalAlignment="Center">Imprimir cierre de caja</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
