<UserControl 
        x:Class="TreskelRest.frms.ctls.ctlFacturacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TreskelRest.frms.ctls"
        mc:Ignorable="d" Background="White" 
        d:DesignHeight="700" d:DesignWidth="1300" GotFocus="UserControl_GotFocus">
    <DockPanel>
        <DockPanel.Resources>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="3"/>
            </Style>
        </DockPanel.Resources>

        <Grid x:Name="GridFact" DockPanel.Dock="Right" Width="420">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="100">
                    <GroupBox Header="Cliente"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="1"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Margin" Value="3"/>
                                    </Style>
                                </StackPanel.Resources>
                                <!--<Button x:Name="cambiaTipoPedido" Width="70" Height="60" IsEnabled="False" Click="cambiaTipoPedido_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image x:Name="imgTipoPedd" Source="../../images/toserv.png" Width="30" Height="30"/>
                                        <Label x:Name="lblTipo" Content="Local" />
                                    </StackPanel>
                                </Button>-->
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="N° Id : " Width="55" FontSize="12" Height="30" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCedula" Width="154" FontSize="16" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <Button x:Name="btnBscCli" Margin="0" Width="50" Click="btnBscCli_Click">
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/find.png" Width="30" Height="30"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnBorrar" Margin="0" Width="50" Click="btnBorrar_Click">
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/delete.png" Width="30" Height="30"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Cliente : " Width="55" FontSize="12" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCliente" IsEnabled="False" Width="255" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <!-- <TextBox x:Name="txtCliente" IsEnabled="False" Width="213" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />  -->
                                        <ToggleButton x:Name="btnCdtoDir" Margin="0" Width="40" IsEnabled="False" IsChecked="False" Visibility="Visible">
                                            <ToggleButton.Style>
                                                <Style TargetType="{x:Type ToggleButton}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Background" Value="Red"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="true">
                                                            <Setter Property="Background" Value="LightGreen"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/creditoDirecto.png" Width="25" Height="25"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="btnCliFnl" Width="65" Height="60" Click="btnCliFnl_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image Source="../../images/client.png" Width="30" Height="30"/>
                                        <Label Content="Cli. Final" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid DockPanel.Dock="Bottom" Height="175">
                    <GroupBox Header="Detalle" FontSize="16"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Sub sin Iva:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    <TextBox x:Name="txtSubTot0" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Recibido:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    <TextBox x:Name="txtRecibido" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Cambio:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtCambio" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Sub con Iva:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtSubTot" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Descuento:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtDscto" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Iva:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtIva" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtTotal" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid>
                    <DataGrid x:Name="dgvPedd" Width="Auto" Height="Auto" Margin="0,0,0,0"
                            AlternationCount="2" AlternatingRowBackground="Aquamarine"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            CanUserReorderColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            FontSize="12" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="70">
                                <!-- Header="Acción" -->
                                <DataGridTemplateColumn.Header>
                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="btnDelItems" Margin="0,0,0,0" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Left" Click="btnDelItems_Click">
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/delete.png" Width="20" Height="20"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="Acción" HorizontalAlignment="Left" />
                                    </Grid>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="btnDelItem" Width="33" Height="33" Margin="2" Background="Transparent" BorderBrush="Transparent" Click="btnDelItem_Click">
                                                <Image Source="../../images/delete.png" Width="20" Height="20" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="70" Visibility="Hidden" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding producto}" Width="160"  />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="70" CellStyle="{StaticResource CentroCell}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="70" CellStyle="{StaticResource DerechaCell}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding total}" Width="50" CellStyle="{StaticResource CentroCell}" Visibility="Hidden" />
                            <DataGridTextColumn Header="IVA" Binding="{Binding iva}" Width="100" Visibility="Hidden" />
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Height="100" Width="Auto" Margin="5,5,5,5">
            <GroupBox Header="Facturación / Market" BorderBrush="Black" BorderThickness="2" Width="Auto" >
                <Grid x:Name="PedidosGrid" Width="Auto">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Width="Auto">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Button x:Name="btnSalir" Width="70" Height="70" Margin="0,0,3,0" Background="LightCoral" Click="btnSalir_Click">
                            <StackPanel>
                                <Image Source="../../images/cancel.png" Width="30" Height="30" />
                                <Label Content="Salir" FontSize="14" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCrear" Width="70" Height="70" Margin="0,0,3,0" Background="Beige" Click="btnCrear_Click">
                            <StackPanel>
                                <Image Source="../../images/buy.png" Width="30" Height="30" />
                                <Label Content="Crear" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnCancelar" Width="70" Height="70" Background="Aqua" Margin="0,0,3,0" Click="btnCancelar_Click" IsEnabled="False">
                            <StackPanel>
                                <Image Source="../../images/undo.png" Width="30" Height="30" />
                                <Label Content="Cancelar" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnBscPedd" Width="70" Height="70" Margin="0,0,3,0" Background="Beige" Click="btnBscPedd_Click">
                            <StackPanel>
                                <Image Source="../../images/findbill.png" Width="30" Height="30" />
                                <Label Content="Buscar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnFacturar" IsEnabled="False" Width="70" Height="70" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnFacturar_Click">
                            <StackPanel>
                                <Image Source="../../images/tobill.png" Width="30" Height="30" />
                                <Label Content="Facturar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnAnlFact" Width="70" Height="70" IsEnabled="False" Background="BlanchedAlmond" Margin="0,0,3,0" Click="btnAnlFact_Click">
                            <StackPanel>
                                <Image Source="../../images/cancelbill.png" Width="30" Height="30" />
                                <Label Content="Anular" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnDelFact" IsEnabled="False" Width="70" Height="70"  Margin="0,0,3,0" Background="BlanchedAlmond" Click="btnDelFact_Click">
                            <StackPanel>
                                <Image Source="../../images/delete.png" Width="30" Height="30" />
                                <Label Content="Eliminar" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <!--<Button x:Name="btngift" IsEnabled="False" Width="70" Height="70" Margin="3,0,3,0" Background="GreenYellow" Click="btngift_Click">
                            <StackPanel>
                                <Image Source="../../images/gift.png" Width="30" Height="30" />
                                <Label Content="Cortesía" FontSize="12" />
                            </StackPanel>
                        </Button>-->
                        <Button x:Name="btnDescto" IsEnabled="False" Width="70" Height="70" Margin="0,0,3,0" Background="GreenYellow" Click="btnDescto_Click">
                            <StackPanel>
                                <Image Source="../../images/discount.png" Width="30" Height="30" />
                                <Label Content="Descuento" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnToPay" IsEnabled="False" Width="70" Height="70" Background="GreenYellow" Margin="0,0,3,0" Click="btnToPay_Click">
                            <StackPanel>
                                <Image Source="../../images/topay.png" Width="30" Height="30" />
                                <Label Content="Pago" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid HorizontalAlignment="Stretch" Margin="0, 0, 0, 0" Width="Auto" >
                        <!--<Label x:Name="Mesero" FontSize="18" HorizontalAlignment="Right" Margin="0, 0, 80, 0" VerticalContentAlignment="Center" Height="60" Width="100" HorizontalContentAlignment="Center" />-->
                        <ToggleButton x:Name="btnCajero" Width="70" Height="70" Background="GhostWhite" HorizontalAlignment="Right" Checked="btnCajero_Checked" Unchecked="btnCajero_Unchecked">
                            <StackPanel>
                                <Image Source="../../images/cajero.png" Width="30" Height="30" />
                                <Label Content="Cajero" FontSize="14" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
        <!--<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">-->
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="pedidoContainer" Width="Auto" Height="Auto" Margin="3,3,3,3" FlowDirection="LeftToRight" VerticalAlignment="Top" Orientation="Horizontal" >

                </WrapPanel>
            </ScrollViewer>

            <TextBox x:Name="barcode" Width="200" Visibility="Visible" Margin="3,3,3,3" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Background="Aquamarine" VerticalContentAlignment="Center" />
            <TextBox x:Name="buscaItem" Width="200" Visibility="Visible" Margin="3,3,98,3" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" VerticalContentAlignment="Center"  CharacterCasing="Upper" />
            <Button x:Name="btnBscItem" Margin="3,3,50,3" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Content=" Buscar " Click="btnBscItem_Click"  VerticalContentAlignment="Center"/>
            <Button x:Name="btnBscCls" Margin="3,3,3,3" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Content="Limpiar" Click="btnBscCls_Click"  VerticalContentAlignment="Center"/>
        </Grid>
    </DockPanel>
</UserControl>