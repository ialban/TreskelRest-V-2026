<UserControl x:Class="TreskelRest.frms.ctls.ctlFacturaSRI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <DockPanel.Resources>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="3"/>
            </Style>
        </DockPanel.Resources>
        <Grid DockPanel.Dock="Top">
            <GroupBox Header="Acciones" Height="90" BorderBrush="Black" BorderThickness="2" Margin="0,0,0,0">
                <StackPanel Width="Auto" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="btnSalir" Width="75" Height="65" Background="LightCoral" Click="btnSalir_Click">
                        <StackPanel>
                            <Image Source="../../images/cancel.png" Width="30" Height="30" />
                            <Label Content="Salir" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCancelar" IsEnabled="False" Width="75" Height="65" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnCancelar_Click">
                        <StackPanel>
                            <Image Source="../../images/undo.png" Width="30" Height="30" />
                            <Label Content="Cancelar" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnGrabar" IsEnabled="False" Width="75" Height="65" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnGrabar_Click">
                        <StackPanel>
                            <Image Source="../../images/process.png" Width="30" Height="30" />
                            <Label Content="Procesar" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Vertical">
                        <Label Content="Fecha:" Margin="30,0,0,0" FontSize="12" />
                        <DatePicker x:Name="fecha" FontSize="16" Margin="30,0,0,0" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                        <Label Content="Filtrar por:" Margin="0,0,0,0" FontSize="12" />
                        <ComboBox x:Name="Filtro" FontSize="16" Height="40" Width="140" VerticalContentAlignment="Center">
                            <ComboBoxItem Tag ="N" Height="40" VerticalContentAlignment="Center" IsSelected="True">No procesados</ComboBoxItem>
                            <ComboBoxItem Tag ="P" Height="40" VerticalContentAlignment="Center">Pendientes</ComboBoxItem>
                            <ComboBoxItem Tag ="D" Height="40" VerticalContentAlignment="Center">Devueltos</ComboBoxItem>
                            <ComboBoxItem Tag ="V" Height="40" VerticalContentAlignment="Center">Validados</ComboBoxItem>
                            <ComboBoxItem Tag ="A" Height="40" VerticalContentAlignment="Center">Autorizados</ComboBoxItem>
                            <ComboBoxItem Tag ="L" Height="40" VerticalContentAlignment="Center">Anulados</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="btnBscRsv" Margin="20,0,0,0" Width="75" Height="65" Click="btnBscRsv_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/find.png" Width="30" Height="30"/>
                            <Label Content="Buscar" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="cntFacturas" Text="Cantidad de Facturas: 0" TextWrapping="Wrap" TextAlignment="Center" Width="90" Margin="30,10,10,10" FontSize="12" HorizontalAlignment="Right">

                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid x:Name="FacturasContainer" DockPanel.Dock="Left">
            <DataGrid x:Name="Resultado" Width="Auto" Height="Auto" Margin="0,0,0,0"
                              AlternationCount="2" AlternatingRowBackground="Aquamarine"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" 
                              CanUserReorderColumns="False" CanUserAddRows="False"
                              FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" ColumnHeaderHeight="45"
                            >
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar">
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="30"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pedido" Binding="{Binding peddscl}" Width="100" />
                    <DataGridTextColumn Header="Serial" Binding="{Binding ventscl}" Width="100" />
                    <DataGridTemplateColumn Header="Doc." Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Image Source="{Binding docuTipImg}" Width="33" Height="33">
                                    <Image.ToolTip>
                                        <ToolTip Content="{Binding docuToolTip}" />
                                    </Image.ToolTip>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate >
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tipo" Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Image Source="{Binding docuRetImg}" Width="33" Height="33">
                                    <Image.ToolTip>
                                        <ToolTip Content="{Binding docuTipRet}" />
                                    </Image.ToolTip>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate >
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Cliente/Prov." Binding="{Binding nidnbr}" Width="250" />
                    <DataGridTextColumn Header="Iva" Binding="{Binding ventiva}" Width="80"  />
                    <DataGridTextColumn Header="Total" Binding="{Binding venttot}" Width="80" />
                    <!--<DataGridTextColumn Header="Estado" Binding="{Binding etdofac}" Width="130" />-->
                    <DataGridTemplateColumn Header="Estado" Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Image x:Name="imgEstado" Source="{Binding etdofacImg}" Width="33" Height="33" MouseDown="imgEstado_MouseDown">
                                    <!-- <Image Source="{Binding etdofacImg}" Source="../../images/toprocess.png" Width="29" Height="29" /> -->
                                    <Image.ToolTip>
                                        <!--<ToolTip Content="{Binding etdofac}" />-->
                                        <ToolTip>
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock FontWeight="Bold" Text="{Binding etdofac}" />
                                                <TextBlock Text="{Binding etdofacdet}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Image.ToolTip>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate >
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Proc." Width="60" >
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="btnProcesar" Width="33" Height="33" Margin="1" Background="Transparent" BorderBrush="Transparent" Click="btnProcesar_Click" IsEnabled="{Binding ToProcessEnable, Mode=TwoWay}" >
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                                            <Image Source="../../images/process.png" Width="29" Height="29" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mail" Width="60" >
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="btnEnviar" Width="33" Height="33" Margin="1" Background="Transparent" BorderBrush="Transparent" Click="btnProcesar_Click" >
                                        <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                                            <Image Source="../../images/mailsend.png" Width="29" Height="29" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Check" Width="60" >
                        <DataGridTemplateColumn.CellTemplate >
                            <DataTemplate>
                                <Grid>
                                    <Button x:Name="btnVerificar" Width="33" Height="33" Margin="1" Background="Transparent" BorderBrush="Transparent" Click="btnVerificar_Click" >
                                        <StackPanel Orientation="Vertical">
                                            <Image Source="../../images/verificar.png" Width="29" Height="29" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type DataGridCell}">
                                    <Grid Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
