<UserControl x:Class="TreskelRest.frms.ctls.ctlReporteSRI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls" 
             xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Height="60" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb51a" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/process.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Generar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <Label Content="Mensual:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Grid.ColumnSpan="3" />
                <CheckBox x:Name="chkMensual" Margin="110,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="2" Height="15" Width="16" Checked="chkMensual_Checked" Unchecked="chkMensual_Unchecked">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <GroupBox x:Name="Diario" Header="Diario" Margin="10, 60, 10, 0" Height="90" VerticalAlignment="Top" FontSize="16">
                    <Grid>
                        <Label Content="Fecha" FontSize="16" Width="50" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <DatePicker x:Name="fecha" FontSize="16" Width="350" Height="40" Margin="100,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />
                    </Grid>    
                </GroupBox>
                <GroupBox x:Name="Mensual" Header="Mensual" Margin="10, 160, 10, 0" Height="150" VerticalAlignment="Top" FontSize="16">
                    <Grid>
                        <Label Content="Año" FontSize="16" Width="50" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <spinner:ctlSpinner x:Name="txtAnio" HorizontalAlignment="Left" Margin="100,10,0,0" VerticalAlignment="Top"/>
                        <Label Content="Mes" FontSize="16" Width="50" Height="40" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <ComboBox x:Name="cboMes" FontSize="16" Width="350" Height="40" Margin="100,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center">
                            <ComboBoxItem Tag="" Height="50" VerticalContentAlignment="Center">-- Seleccione un Mes --</ComboBoxItem>
                            <ComboBoxItem Tag="1" Height="40" VerticalContentAlignment="Center">Enero</ComboBoxItem>
                            <ComboBoxItem Tag="2" Height="40" VerticalContentAlignment="Center">Febrero</ComboBoxItem>
                            <ComboBoxItem Tag="3" Height="40" VerticalContentAlignment="Center">Marzo</ComboBoxItem>
                            <ComboBoxItem Tag="4" Height="40" VerticalContentAlignment="Center">Abril</ComboBoxItem>
                            <ComboBoxItem Tag="5" Height="40" VerticalContentAlignment="Center">Mayo</ComboBoxItem>
                            <ComboBoxItem Tag="6" Height="40" VerticalContentAlignment="Center">Junio</ComboBoxItem>
                            <ComboBoxItem Tag="7" Height="40" VerticalContentAlignment="Center">Julio</ComboBoxItem>
                            <ComboBoxItem Tag="8" Height="40" VerticalContentAlignment="Center">Agosto</ComboBoxItem>
                            <ComboBoxItem Tag="9" Height="40" VerticalContentAlignment="Center">Septiembre</ComboBoxItem>
                            <ComboBoxItem Tag="10" Height="40" VerticalContentAlignment="Center">Octubre</ComboBoxItem>
                            <ComboBoxItem Tag="11" Height="40" VerticalContentAlignment="Center">Noviembre</ComboBoxItem>
                            <ComboBoxItem Tag="12" Height="40" VerticalContentAlignment="Center">Diciembre</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </GroupBox>
                
            </Grid>

        </DockPanel>
    </Grid>
</UserControl>
