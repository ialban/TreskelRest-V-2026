<UserControl x:Class="TreskelRest.frms.ctls.ctlMotivosAnula"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="500">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="60" HorizontalAlignment="Left">
                <Label Content="Número de Factura" FontSize="16" Height="60" VerticalContentAlignment="Center"></Label>
                <TextBox x:Name="NumFact" Width="220" FontSize="16" Height="50" Text="" MaxLength="10" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,0,0,0" ></TextBox>
            </Grid>
            <Grid DockPanel.Dock="Bottom" Height="60" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="270" VerticalAlignment="Top" Margin="3, 3, 3, 3" >
                    <ScrollViewer.Resources>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="MinHeight" Value="30" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="30" />
                                    <Setter Property="MinWidth" Value="30" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <WrapPanel x:Name="motivosContainer" Width="Auto" Height="Auto" Margin="3,3,3,3" FlowDirection="LeftToRight" VerticalAlignment="Top" Orientation="Horizontal" >
                        <WrapPanel.Resources>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </WrapPanel.Resources>
                    </WrapPanel>
                </ScrollViewer>
                <Label Content="Complemento:" Height="50" FontSize="16" Margin="3, 280, 3, 3" Width="200" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                <TextBox Text="" Margin="120, 280, 5, 3" Width="320" Height="50" FontSize="16" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            </Grid>
        </DockPanel>   
    </Grid>
</UserControl>
