<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaMateriaPrima"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" d:DesignWidth="900" Height="386">
    <Grid>
        <Label x:Name="label1" Content="Código : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="116,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="4"/>
        <Label Content="Unidad : " HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cboUnidad" HorizontalAlignment="Left" Margin="116,73,0,0" VerticalAlignment="Top" Width="200" Height="40" VerticalContentAlignment="Center" FontSize="16">
            <ComboBoxItem Tag="" Height="40" VerticalContentAlignment="Center" FontSize="16" Content="-- Seleccione --" IsSelected="True"/>
            <ComboBoxItem Tag="U" Height="40" VerticalContentAlignment="Center" FontSize="16" >Unidad</ComboBoxItem>
            <ComboBoxItem Tag="L" Height="40" VerticalContentAlignment="Center" FontSize="16">Libra</ComboBoxItem>
            <ComboBoxItem Tag="K" Height="40" VerticalContentAlignment="Center" FontSize="16">Kilo</ComboBoxItem>
            <ComboBoxItem Tag="O" Height="40" VerticalContentAlignment="Center" FontSize="16">Onza</ComboBoxItem>
            <ComboBoxItem Tag="G" Height="40" VerticalContentAlignment="Center" FontSize="16">Gramo</ComboBoxItem>
        </ComboBox>
        <Label x:Name="label4" Content="Producto : " HorizontalAlignment="Left" Margin="9,130,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtNombre" HorizontalAlignment="Left" Height="40" Margin="116,130,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="535" FontSize="16" VerticalContentAlignment="Center" MaxLength="100"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
        <Label x:Name="label" Content="Vta. Directa : " HorizontalAlignment="Left" Margin="10,196,0,0" VerticalAlignment="Top" FontSize="16"/>
        <CheckBox x:Name="chkFinal" HorizontalAlignment="Left" Margin="117,192,0,0" VerticalAlignment="Top" IsChecked="False">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Label Content="Código de Barras : " HorizontalAlignment="Left" Margin="200,189,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtBarCode" HorizontalAlignment="Left" Height="40" Margin="352,189,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="300" FontSize="16" VerticalContentAlignment="Center" MaxLength="100"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
        <Label Content="Grupo : " HorizontalAlignment="Left" Margin="200,242,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cboGrupo" HorizontalAlignment="Left" Margin="352,242,0,0" VerticalAlignment="Top" Width="299" Height="40" VerticalContentAlignment="Center" FontSize="16">
            <ComboBoxItem Tag="" IsSelected="True" Content="-- Todos --" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Tag="P" Content="Pan y Tortas" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Tag="R" Content="Cereales" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Tag="S" Content="Pastas" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Tag="V" Content="Vegetal" Height="40" VerticalContentAlignment="Center" />
            <ComboBoxItem Tag="C" Content="Carnes" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="B" Content="Bebidas" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="A" Content="Bebidas Alcoholicas" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="L" Content="Lacteos" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="M" Content="Mariscos" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="E" Content="Especias" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="F" Content="Frutas" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="H" Content="Herramientas" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="T" Content="Materiales/Trabajo" Height="40" VerticalContentAlignment="Center"/>
            <ComboBoxItem Tag="O" Content="Otros" Height="40" VerticalContentAlignment="Center"/>
        </ComboBox>
        <Label Content="Graba Iva : " HorizontalAlignment="Left" Margin="10,246,0,0" VerticalAlignment="Top" FontSize="16"/>
        <CheckBox x:Name="chkUsaIva" HorizontalAlignment="Left" Margin="117,242,0,0" VerticalAlignment="Top" IsChecked="true">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
            </CheckBox.LayoutTransform>
        </CheckBox>
        <Label Content="Activo : " HorizontalAlignment="Left" Margin="10,290,0,0" VerticalAlignment="Top" FontSize="16"/>
        <CheckBox x:Name="chkActivo" HorizontalAlignment="Left" Margin="117,290,0,0" VerticalAlignment="Top" IsChecked="true">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Border BorderThickness="1" Margin="678,10,10,166" Width="212" Height="210" BorderBrush="Black">
            <Image x:Name="imgProducto" Source="../../images/noimage.png" HorizontalAlignment="Left" Height="210" Margin="0,0,0,0" VerticalAlignment="Top" Width="210" Stretch="Fill">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="mnuPegar" Header="Pegar"  Click="mnuPegar_Click">
                            <MenuItem.Icon>
                                <Image x:Name="Paste" Source="../../images/paste.png" Height="16" Width="16" Margin="-2,-4,-4,-4" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="mnuLimpiar" Header="Eliminar"  Click="mnuLimpiar_Click">
                            <MenuItem.Icon>
                                <Image x:Name="Delete" Source="../../images/delete.png" Height="16" Width="16" Margin="-2,-4,-4,-4" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Border>
        <Button x:Name="btnLoad" HorizontalAlignment="Left" Margin="678,235,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnLoad_Click">
            <Button.Background>
                <SolidColorBrush Color="#5cb85c" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/upload.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Cargar</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnNoImage" HorizontalAlignment="Left" Margin="816,235,0,0" VerticalAlignment="Top" Width="74" Height="40" Foreground="White" FontSize="16" Click="btnNoImage_Click">
            <Button.Background>
                <SolidColorBrush Color="#d9534f" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/noimage.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

        <Grid HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,325,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,325,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
            </Grid>
        </Grid>
</UserControl>
