<UserControl x:Class="TreskelRest.frms.ctls.ctlUsuarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Width="Auto" Height="Auto" Margin="25">
        <Label x:Name="label" Content="Empleado:" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <TextBox x:Name="txtApellidos" HorizontalAlignment="Left" Height="40" Margin="90,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200"  FontSize="16" VerticalContentAlignment="Center" />
        <Label x:Name="label1" Content="Estado:" HorizontalAlignment="Left" Margin="290,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <ComboBox x:Name="cboEstado" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="355,10,0,0" Width="140" Height="40"  FontSize="16"  VerticalContentAlignment="Center" >
            <ComboBoxItem Tag="" IsSelected="True" Height="40">-- TODOS --</ComboBoxItem>
            <ComboBoxItem Tag="A" Height="40">Activos</ComboBoxItem>
            <ComboBoxItem Tag="I" Height="40">Inactivos</ComboBoxItem>
        </ComboBox>
        <Button x:Name="btnBuscar" Margin="510,10,0,0" Width="100" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Foreground="White" Click="btnBuscar_Click">
            <Button.Background>
                <SolidColorBrush Color="#5bc0de" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Buscar</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnNuevo" Margin="60,10,120,0" Width="110" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Foreground="White" Click="btnNuevo_Click" >
            <Button.Background>
                <SolidColorBrush Color="#5cb85c" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/add.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Nuevo</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnSalir" Margin="60,10,0,0" Width="110" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Foreground="White" Click="btnSalir_Click">
            <Button.Background>
                <SolidColorBrush Color="#d9534f" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/cancel.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
            </StackPanel>
        </Button>
        <DataGrid x:Name="Resultado" Width="Auto" Height="Auto" Margin="0,70,0,0"
                  AlternationCount="2" AlternatingRowBackground="Aquamarine"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  CanUserReorderColumns="True" CanUserAddRows="False" IsReadOnly="True"
                  FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Acción" Width="80" >
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <Grid>
                                <Button Width="70" Height="40" Margin="3" Background="Transparent" BorderBrush="Transparent" Click="Editar_Click" >
                                    <Image Source="../../images/edit.png" Width="30" Height="30" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="150" />
                <DataGridTextColumn Header="Usuario" Binding="{Binding usuario}" Width="200" />
                <DataGridTextColumn Header="Empleado" Binding="{Binding empleado}" Width="300" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding tipo}" Width="200" />
                <DataGridTextColumn Header="Estado" Binding="{Binding estado}" Width="100" />
            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</UserControl>
