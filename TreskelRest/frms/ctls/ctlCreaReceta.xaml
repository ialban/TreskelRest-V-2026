<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaReceta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="500" d:DesignWidth="980">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Height="70" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="140,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <GroupBox x:Name="groupBox" Header="Receta" HorizontalAlignment="Left" Margin="5,5,5,5" VerticalAlignment="Top" Width="968" Height="415">
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="3" />
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Height="60">
                        <Label Content="Comida : " Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                        <ComboBox x:Name="cboItem" Height="40" Width="350" Margin="10,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" >

                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="60">
                        <Label Content="Producto : " Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                        <ComboBox x:Name="cboProducto" Height="40" Width="350" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="16" VerticalContentAlignment="Center" SelectionChanged="cboProducto_SelectionChanged">

                        </ComboBox>
                        <ComboBox x:Name="cboUnidad" Height="40" Width="70" Margin="5,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"  FontSize="16" VerticalContentAlignment="Center">
                            
                        </ComboBox>
                        <Label Content="Cantidad:" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                        <TextBox x:Name="txtCantidad" Height="40" FontSize="16" Width="100" Margin="3,0,0,0" VerticalContentAlignment="Center" />
                        <Label Content="Afect. Inv:" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                        <CheckBox x:Name="chkInv" IsChecked="True" Margin="3, 10, 0, 0">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Button x:Name="add" Content="+" FontSize="20" VerticalContentAlignment="Center" FontWeight="Bold" Height="40" Width="40" Margin="30,0,0,0" Background="GreenYellow" Click="add_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <DataGrid x:Name="dgvProductos" Width="940" Height="250" Margin="0,0,0,0"
                              AlternationCount="2" AlternatingRowBackground="Aquamarine"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" 
                              CanUserReorderColumns="True" CanUserAddRows="False"
                              FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" 
                              AutoGenerateColumns="False"  IsReadOnly="True" >     
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Acción" Width="110" >
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Resources>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Margin" Value="3" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <Button Width="50" Height="40" Background="Transparent" BorderBrush="Transparent" Click="Eliminar_Click" >
                                                    <Image Source="../../images/delete.png" Width="30" Height="30" />
                                                </Button>
                                                <Button Width="50" Height="40" Background="Transparent" BorderBrush="Transparent" Click="Editar_Click" >
                                                    <Image Source="../../images/edit.png" Width="30" Height="30" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="120" />
                                <DataGridTextColumn Header="Producto" Binding="{Binding item}" Width="320" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="100" />
                                <DataGridTextColumn Header="Unidad" Binding="{Binding unidad}" Width="120" />
                                <DataGridTextColumn Header="Inventario" Binding="{Binding inventario}" Width="120" />
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </DockPanel>
    </Grid>
</UserControl>
