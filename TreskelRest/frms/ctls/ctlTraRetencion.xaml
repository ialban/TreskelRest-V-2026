<UserControl x:Class="TreskelRest.frms.ctls.ctlTraRetencion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:TextBoxMask="clr-namespace:LibControls.TextBoxMask;assembly=LibControls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="550" d:DesignWidth="1200">
    <DockPanel>
        <DockPanel.Resources>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="3"/>
            </Style>
        </DockPanel.Resources>

        <Grid DockPanel.Dock="Right" Width="440">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="100">
                    <GroupBox Header="Proveedor"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="1"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Margin" Value="3"/>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="N° Id : " Width="70" FontSize="12" Height="30" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCedula" Width="200" FontSize="16" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <Button x:Name="btnBorrar" Margin="0" Width="50" Click="btnBorrar_Click">
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/delete.png" Width="30" Height="30"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Proveedor : " x:Name="lblNbrProv" Width="70" FontSize="12" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCliente" IsEnabled="False" Width="250" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="btnBscCli" Width="65" Height="63" Click="btnBscCli_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image Source="../../images/find.png" Width="30" Height="30"/>
                                        <Label Content="Buscar" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid DockPanel.Dock="Bottom" Height="90">
                    <GroupBox Header="Detalle" FontSize="16"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    <TextBox x:Name="txtTotal" Width="150" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid>
                    <DataGrid x:Name="dgvRetc" Width="Auto" Height="Auto" Margin="0,0,0,0"
                            AlternationCount="2" AlternatingRowBackground="Aquamarine"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            CanUserReorderColumns="False" CanUserAddRows="False" IsEnabled="true" IsReadOnly="true"
                            FontSize="12" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Acción" Width="40" >
                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="btnDelItem" Width="33" Height="33" Margin="2" Background="Transparent" BorderBrush="Transparent" Click="btnDelItem_Click" >
                                                <Image Source="../../images/delete.png" Width="20" Height="20" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding codsri}" Width="70" Visibility="Hidden" />
                            <DataGridTextColumn Header="Anio Fisc" Binding="{Binding aniofisc}" Width="70"  />
                            <DataGridTextColumn Header="Base Impo" Binding="{Binding baseimpo}" Width="70" CellStyle="{StaticResource CentroCell}" />
                            <DataGridTextColumn Header="Impuesto" Binding="{Binding tipoimpo}" Width="70" CellStyle="{StaticResource DerechaCell}" />
                            <DataGridTextColumn Header="Porcentaje" Binding="{Binding pctrete}" Width="70" CellStyle="{StaticResource CentroCell}"  />
                            <DataGridTextColumn Header="Valor" Binding="{Binding valorrete}" Width="70" />
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Height="110" Width="Auto" Margin="5,5,5,5">
            <GroupBox Header="Acciones" BorderBrush="Black" BorderThickness="2" >
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                    </StackPanel.Resources>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Margin="2,2.5,3,2.5">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="btnSalir" Width="75" Height="65" Background="LightCoral" Click="btnSalir_Click">
                                <StackPanel>
                                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                                    <Label Content="Salir" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCancelar" IsEnabled="False" Width="75" Height="65" Background="Beige" Margin="15,0,3,0" Click="btnCancelar_Click">
                                <StackPanel>
                                    <Image Source="../../images/undo.png" Width="30" Height="30" />
                                    <Label Content="Cancelar" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnGrabar" IsEnabled="False" Width="75" Height="65" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnGrabar_Click">
                                <StackPanel>
                                    <Image Source="../../images/save.png" Width="30" Height="30" />
                                    <Label Content="Grabar" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAnlFact" Width="75" Height="65" IsEnabled="False" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnAnlFact_Click">
                                <StackPanel>
                                    <Image Source="../../images/cancelbill.png" Width="30" Height="30" />
                                    <Label Content="Anular" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDelFact" IsEnabled="False" Width="75" Height="65"  Margin="3,0,3,0" Background="BlanchedAlmond" Click="btnDelFact_Click">
                                <StackPanel>
                                    <Image Source="../../images/delete.png" Width="30" Height="30" />
                                    <Label Content="Eliminar" FontSize="12" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                            <Label x:Name="Mesero" FontSize="18" VerticalContentAlignment="Center" Height="60" Width="100" HorizontalContentAlignment="Center" />
                            <ToggleButton x:Name="btnCajero" Width="80" Height="70" Background="GhostWhite" HorizontalAlignment="Right" Checked="btnCajero_Checked" Unchecked="btnCajero_Unchecked">
                                <StackPanel>
                                    <Image Source="../../images/cajero.png" Width="30" Height="30" />
                                    <Label Content="Cajero" FontSize="14" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid x:Name="RetencionContainer">
            <Label Content="Tipo Retención : " FontSize="14" Height="40" Margin="10, 10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cboConcepto" VerticalContentAlignment="Center" FontSize="14" Height="40" Width="210" Margin="176,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <ComboBoxItem Tag="C" Height="35" IsSelected="True" Content="Compra" VerticalContentAlignment="Center" />
                <ComboBoxItem Tag="V" Height="35" VerticalContentAlignment="Center">Venta</ComboBoxItem>
            </ComboBox>
            <Label Content="Tipo Comprobante : " FontSize="14" Height="40" Margin="390,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="140"/>
            <ComboBox x:Name="cboTipoComp" VerticalContentAlignment="Center" FontSize="14" Height="40" Width="190" Margin="540,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <ComboBoxItem Tag="F" Height="35" IsSelected="True" Content="Factura" VerticalContentAlignment="Center" />
                <ComboBoxItem Tag="N" Height="35" VerticalContentAlignment="Center">Nota de Venta</ComboBoxItem>
                <ComboBoxItem Tag="L" Height="35" VerticalContentAlignment="Center">Liquidaciones y Prestación de Servicios</ComboBoxItem>
                <ComboBoxItem Tag="T" Height="35" VerticalContentAlignment="Center">Tickets</ComboBoxItem>
                <ComboBoxItem Tag="O" Height="35" VerticalContentAlignment="Center">Otros</ComboBoxItem>
            </ComboBox>
            <Label Content="Número Comprobante : " FontSize="14" Height="40" Margin="10,65,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <TextBoxMask:TextBoxMask x:Name="txtNumComp" Style="{StaticResource placeHolder}" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="176,65,0,0" Height="40" Width="170" MaxLength="17" Masked="Factura" />
            <Button x:Name="btnBscFac" Width="40" Height="40" Click="btnBscFac_Click" Margin="346,65,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Orientation="Vertical">
                    <Image Source="../../images/find.png" Width="30" Height="30"/>
                </StackPanel>
            </Button>
            <Label Content="Fecha Emisión : " FontSize="14" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Width="140" Margin="390,65,0,0"/>
            <DatePicker x:Name="FechaEmision" Height="40" Width="190" FontSize="14" Margin="540,65,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" CalendarStyle="{StaticResource styleCalendar}"/>
            <!--<Label Content="Número Autorización : " FontSize="14" Height="40" Margin="10,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <TextBoxMask:TextBoxMask x:Name="txtNumAut" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="176,120,0,0" Height="40" Width="514" MaxLength="49" Masked="AutorizacionSRI" Style="{StaticResource placeHolder}" />-->
            <Label Content="Ejercicio Fiscal : " FontSize="14" Height="40" Margin="10,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
            <TextBoxMask:TextBoxMask x:Name="txtEjerFisc" FontSize="14" Style="{StaticResource placeHolder}" 
                                     VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                                     Margin="175,120,0,0" Height="40" Width="100" MaxLength="7" TextChanged="txtEjerFisc_TextChanged"  
                                     Masked="PeriodoFiscal" />
            <!--<Button x:Name="btnBscFacCod" Width="40" Height="40" Click="btnBscFacCod_Click" Margin="690,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Orientation="Vertical">
                    <Image Source="../../images/find.png" Width="30" Height="30"/>
                </StackPanel>
            </Button>-->
            <GroupBox Header="Detalle de Retenciones" Margin="10,180,10,10" >
                <Grid>
                    <Label Content="Base Imponible : " FontSize="14" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="txtBaseImpo" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" 
                             Margin="120,10,0,0" Height="40" Width="130" MaxLength="10" Text="0.00" TextChanged="txtBaseImpo_TextChanged" />
                    <Label Content="Tipo Retención : " FontSize="14" Height="40" Margin="280,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboTipoRet" VerticalContentAlignment="Center" FontSize="14" Height="40" Width="150" Margin="430,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" SelectionChanged="cboTipoRet_SelectionChanged">
                        <ComboBoxItem Tag="I" Height="35" IsSelected="True" Content="IVA" VerticalContentAlignment="Center" />
                        <ComboBoxItem Tag="R" Height="35" VerticalContentAlignment="Center">Renta</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="btnSetValores" Width="40" Height="40" Click="btnSetValores_Click" Margin="580,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/asignar.png" Width="30" Height="30"/>
                        </StackPanel>
                    </Button>
                    <Label Content="Porcentaje Retención : " FontSize="14" Height="40" Margin="280,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="cboPctRet" VerticalContentAlignment="Center" FontSize="14" Height="40" Width="200" Margin="430,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" SelectionChanged="cboPctRet_SelectionChanged">

                    </ComboBox>
                    <Label Content="Valor Retenido : " FontSize="14" Height="40" Margin="10,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="txtValor" Text="0" IsEnabled="False" FontSize="14" VerticalAlignment="Top" VerticalContentAlignment="Center" 
                             HorizontalAlignment="Left" Margin="120,70,0,0" Height="40" Width="130" MaxLength="10" />
                    <Button x:Name="btnAdd" Width="70" Click="btnAdd_Click" Margin="650,10,0,0" Height="70" VerticalAlignment="Top" Background="Beige">
                        <Image Source="/TreskelRest;component/images/rightchevron.png" Width="30" Height="30" />
                    </Button>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
