<UserControl x:Class="TreskelRest.frms.ctls.ctlSepFact"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Left" Width="430" HorizontalAlignment="Left">
                <DockPanel>
                    <Grid DockPanel.Dock="top" Height="80">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="btnSalir" Width="75" Height="65" Background="LightCoral" Click="btnSalir_Click">
                                <StackPanel>
                                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                                    <Label Content="Salir" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCancelar" IsEnabled="False" Width="75" Height="65" Background="Beige" Margin="3,3,3,0" Click="btnCancelar_Click">
                                <StackPanel>
                                    <Image Source="../../images/undo.png" Width="30" Height="30" />
                                    <Label Content="Cancelar" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Height="150">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="3" />
                                    </Style>
                                </StackPanel.Resources>

                                <Button x:Name="btnToPay" IsEnabled="False" Width="75" Height="65" Background="GreenYellow" Margin="3,3,3,0" Click="btnToPay_Click">
                                    <StackPanel>
                                        <Image Source="../../images/topay.png" Width="30" Height="30" />
                                        <Label Content="Pago" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnDescto" IsEnabled="False" Width="75" Height="65" Margin="3,3,15,0" Background="GreenYellow" Click="btnDescto_Click">
                                    <StackPanel>
                                        <Image Source="../../images/discount.png" Width="30" Height="30" />
                                        <Label Content="Descuento" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btngift" IsEnabled="False" Width="75" Height="65" Margin="15,3,3,0" Background="GreenYellow" Click="btngift_Click">
                                    <StackPanel>
                                        <Image Source="../../images/gift.png" Width="30" Height="30" />
                                        <Label Content="Cortesía" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Margin" Value="3" />
                                    </Style>
                                </StackPanel.Resources>

                                <Button x:Name="btnFact" Width="75" Height="65" Margin="3,3,0,0" IsEnabled="False" Background="BlanchedAlmond" Click="btnFact_Click">
                                    <StackPanel>
                                        <Image Source="../../images/tobill.png" Width="30" Height="30" />
                                        <Label Content="Facturar" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnImpFact" IsEnabled="False" Width="75" Height="65"  Margin="7,3,14,0" Background="BlanchedAlmond" Click="btnImpFact_Click">
                                    <StackPanel>
                                        <Image Source="../../images/printer.png" Width="30" Height="30" />
                                        <Label Content="Imprimir" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnProform" Width="75" Height="65" Margin="15,3,3,0" IsEnabled="False" Background="BurlyWood" Click="btnProform_Click">
                                    <StackPanel>
                                        <Image Source="../../images/proforma.png" Width="30" Height="30" />
                                        <Label Content="Proforma" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnImpPro" IsEnabled="False" Width="75" Height="65"  Margin="3,3,15,0" Background="BurlyWood" Click="btnImpPro_Click">
                                    <StackPanel>
                                        <Image Source="../../images/printer.png" Width="30" Height="30" />
                                        <Label Content="Imprimir" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <DataGrid x:Name="dgvPedd" Width="Auto" Height="Auto" Margin="0,0,0,0"
                            AlternationCount="2" AlternatingRowBackground="Aquamarine"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            CanUserReorderColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            FontSize="12" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" SelectionChanged="dgvPedd_SelectionChanged" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="70" Visibility="Hidden" />
                                <DataGridTextColumn Header="Producto" Binding="{Binding producto}" Width="210"  />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="70" CellStyle="{StaticResource CentroCell}" />
                                <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="100" CellStyle="{StaticResource DerechaCell}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding total}" Width="50" CellStyle="{StaticResource CentroCell}" Visibility="Hidden" />
                                <DataGridTextColumn Header="IVA" Binding="{Binding iva}" Width="100" Visibility="Hidden" />
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Height" Value="50" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>
            <Grid DockPanel.Dock="Right" Width="420" HorizontalAlignment="Right">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="100">
                        <GroupBox Header="Cliente" BorderBrush="Black" BorderThickness="2">
                            <StackPanel Orientation="Vertical">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Margin" Value="1"/>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="Margin" Value="3"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="N° Id : " Width="55" FontSize="12" Height="30" HorizontalContentAlignment="Left" />
                                            <TextBox x:Name="txtCedula" Width="140" FontSize="16" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Cliente : " Width="55" FontSize="12" HorizontalContentAlignment="Left" />
                                            <TextBox x:Name="txtCliente" IsEnabled="False" Width="205" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="btnBscCli" Width="65" Height="60" Click="btnBscCli_Click">
                                        <StackPanel Orientation="Vertical">
                                            <Image Source="../../images/find.png" Width="30" Height="30"/>
                                            <Label Content="Buscar" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnCliFnl" Width="65" Height="60" Click="btnCliFnl_Click">
                                        <StackPanel Orientation="Vertical">
                                            <Image Source="../../images/client.png" Width="30" Height="30"/>
                                            <Label Content="Cli. Final" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Height="170">
                        <GroupBox Header="Detalle" BorderBrush="Black" BorderThickness="2">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Margin" Value="2"/>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Sub sin Iva:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtSubTot0" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Recibido:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtRecibido" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Cambio:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                        <TextBox x:Name="txtCambio" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="SubTotal:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                        <TextBox x:Name="txtSubTot" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Descuento:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                        <TextBox x:Name="txtDscto" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Iva:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                        <TextBox x:Name="txtIva" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Total:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                        <TextBox x:Name="txtTotal" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <Grid>
                        <DataGrid x:Name="dgvFact" Width="Auto" Height="Auto" Margin="0,0,0,0"
                            AlternationCount="2" AlternatingRowBackground="Aquamarine"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            CanUserReorderColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            FontSize="12" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" SelectionChanged="dgvFact_SelectionChanged" >
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="70" Visibility="Hidden" />
                                <DataGridTextColumn Header="Producto" Binding="{Binding producto}" Width="210"  />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="70" CellStyle="{StaticResource CentroCell}" />
                                <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="100" CellStyle="{StaticResource DerechaCell}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding total}" Width="50" CellStyle="{StaticResource CentroCell}" Visibility="Hidden" />
                                <DataGridTextColumn Header="IVA" Binding="{Binding iva}" Width="100" Visibility="Hidden" />
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Height" Value="50" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="3" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnAdd" Height="70" Width="70" Click="btnAdd_Click">
                        <Image Source="../../images/rightchevron.png" Width="30" Height="30" />
                    </Button>
                    <Button x:Name="btnRemove" Height="70" Width="70" Click="btnRemove_Click">
                        <Image Source="../../images/leftchevron.png" Width="30" Height="30" />
                    </Button>
                    <Button x:Name="btnAll" Height="70" Width="70" Click="btnAll_Click">
                        <Image Source="../../images/doublerightchevron.png" Width="30" Height="30" />
                    </Button>
                    <Button x:Name="btnNone" Height="70" Width="70" Click="btnNone_Click">
                        <Image Source="../../images/doubleleftchevron.png" Width="30" Height="30" />
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
