<UserControl x:Class="TreskelRest.frms.ctls.ctlMovBcos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls" xmlns:switchButton="clr-namespace:LibControls.switchButton;assembly=LibControls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="500" d:DesignWidth="830">
    <Grid>
        <Label Content="Cuentas Bancarias : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                    <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="MinHeight" Value="30" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="MinWidth" Value="30" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <WrapPanel x:Name="OpcOrigen" Margin="160, 5, 0, 0" Height="80" Width="560" VerticalAlignment="Top" HorizontalAlignment="Left" 
                       Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="{x:Type ToggleButton}">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </WrapPanel.Resources>
                
            </WrapPanel>
        </ScrollViewer>

        <Label Content="Descripción : " HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtDescripcion" HorizontalAlignment="Left" Margin="160,100,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="500" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Button x:Name="btnClsDsc" HorizontalAlignment="Left" Margin="665,100,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnClsDsc_Click">
            <Button.Background>
                <SolidColorBrush Color="LightCyan" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/clear.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

        <Label Content="Tipo : " HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <ComboBox x:Name="cboTipo" Width="150" Height="40" Margin="160,160,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" 
                  FontSize="16"  VerticalContentAlignment="Center" SelectionChanged="cboTipo_SelectionChanged">
            <ComboBoxItem Tag="I" FontSize="16" Height="40" VerticalContentAlignment="Center" IsSelected="True">Ingreso</ComboBoxItem>
            <ComboBoxItem Tag="E" FontSize="16" Height="40" VerticalContentAlignment="Center">Egreso</ComboBoxItem>
            <ComboBoxItem Tag="O" FontSize="16" Height="40" VerticalContentAlignment="Center">Otros</ComboBoxItem>
        </ComboBox>
        <ComboBox x:Name="cboTipo2" Width="250" Height="40" Margin="320,160,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" 
                  FontSize="16"  VerticalContentAlignment="Center" SelectionChanged="cboTipo2_SelectionChanged"
                  ItemsSource="{Binding opcionesTipo}"
                  SelectedValue="{Binding codigo}"
                  DisplayMemberPath="descripcion"
                  SelectedValuePath="codigo"
                  >
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="50" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ComboBox.ItemContainerStyle>
            
        </ComboBox>

        <!--
        ItemsSource="{Binding opcionesTipo}"
                  SelectedValue="{Binding codigo}"
                  DisplayMemberPath="descripcion"
                  SelectedValuePath="codigo"
        -->
        <Label Content="Valor : " HorizontalAlignment="Left" Margin="10,220,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <Label Content="Dólares" HorizontalAlignment="Left" Margin="160,220,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
        <TextBox x:Name="txtValor" HorizontalAlignment="Left" Margin="225,220,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Button x:Name="btnClsVal" HorizontalAlignment="Left" Margin="345,220,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnClsVal_Click">
            <Button.Background>
                <SolidColorBrush Color="LightCyan" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/clear.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

        <Label Content="Destinatario : " HorizontalAlignment="Left" Margin="10,280,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <ComboBox x:Name="cboDestinatario" Width="150" Height="40" Margin="160,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" 
                  FontSize="16"  VerticalContentAlignment="Center" SelectionChanged="cboDestinatario_SelectionChanged">
            <ComboBoxItem Tag="I" FontSize="16" Height="40" VerticalContentAlignment="Center" IsSelected="True">Cliente</ComboBoxItem>
            <ComboBoxItem Tag="E" FontSize="16" Height="40" VerticalContentAlignment="Center">Proveedor</ComboBoxItem>
            <ComboBoxItem Tag="O" FontSize="16" Height="40" VerticalContentAlignment="Center">Otros</ComboBoxItem>
        </ComboBox>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="320,280,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20" Tag=""/>
        <TextBox x:Name="txtOtro" HorizontalAlignment="Left" Margin="320,280,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="400" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20"  Tag="" Visibility="Hidden"/>
        <Button x:Name="btnBscNid" HorizontalAlignment="Left" Margin="522,280,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnBscNid_Click">
            <Button.Background>
                <SolidColorBrush Color="LightBlue" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
            </StackPanel>
        </Button>
        <Button x:Name="btnClsNid" HorizontalAlignment="Left" Margin="576,280,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnClsNid_Click">
            <Button.Background>
                <SolidColorBrush Color="LightCyan" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/clear.png" Width="30" Height="30" />
            </StackPanel>
        </Button>
        <Label x:Name ="lblDestinatario" Tag="" Content="Nombre del Cliente/Proveedor" Foreground="Gray" Margin="320, 340,0,0" FontSize="16" Width="500" Height="40" VerticalAlignment="Top" 
               HorizontalAlignment="Left" VerticalContentAlignment="Center" BorderBrush="LightGray" BorderThickness="1"/>

        <Grid Margin="0,10,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="60" Width="280">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
