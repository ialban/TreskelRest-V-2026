<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:checkbox="clr-namespace:LibControls.checkbox;assembly=LibControls" x:Class="TreskelRest.frms.ctls.ctlCreaCliente"
             mc:Ignorable="d" 
             Background="White" d:DesignWidth="700" Height="380">
    <Grid>
        <Label x:Name="label" Content="Tipo de Documento : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <ComboBox x:Name="cboTipo" HorizontalAlignment="Left" Margin="178,10,0,0" VerticalAlignment="Top" Width="120" Height="40" VerticalContentAlignment="Center" FontSize="16" SelectionChanged="cboTipo_SelectionChanged">
            <ComboBoxItem Tag="C" IsSelected="True" Content="Cédula" />
            <ComboBoxItem Tag="R" Content="Ruc" />
            <ComboBoxItem Tag="P" Content="Pasaporte" />
        </ComboBox>
        <Label x:Name="label1" Content="Num. Identificación : " HorizontalAlignment="Left" Margin="314,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="478,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Label x:Name="label2" Content="Cliente : " HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtCliente" HorizontalAlignment="Left" Margin="116,60,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="562" MaxLength="80" FontSize="16" Height="40" VerticalContentAlignment="Center"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps" />
        <Label x:Name="label4" Content="Dirección : " HorizontalAlignment="Left" Margin="9,110,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtDireccion" HorizontalAlignment="Left" Height="40" Margin="116,110,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="562" FontSize="16" VerticalContentAlignment="Center" MaxLength="100" CharacterCasing="Upper" Typography.Capitals="AllSmallCaps" />
        <Label Content="Teléfono : " HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtTfl" HorizontalAlignment="Left" Height="40" Margin="116,160,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="150" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Label Content="Email : " HorizontalAlignment="Left" Margin="10,210,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtEmail" HorizontalAlignment="Left" Height="40" Margin="116,210,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="562" FontSize="16" VerticalContentAlignment="Center" MaxLength="100"/>
        <Label Content="Activo : " HorizontalAlignment="Left" Margin="10,260,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <checkbox:ctlCheckBox x:Name="chkEstado" HorizontalAlignment="Left" Height="40" Margin="116,260,0,0" VerticalAlignment="Top" Width="100"/>
        <Label Content="Sujeto de crédito : " HorizontalAlignment="Left" Margin="170,260,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <checkbox:ctlCheckBox x:Name="chkCredito" HorizontalAlignment="Left" Height="40" Margin="310,260,0,0" VerticalAlignment="Top" Width="50" ctlChecked="chkCredito_ctlChecked" ctlUnChecked="chkCredito_ctlUnChecked"/>
        <Label Content="Se cobra a Empresa : " HorizontalAlignment="Left" Margin="370,260,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <checkbox:ctlCheckBox x:Name="chkCobraEmpresa" HorizontalAlignment="Left" Height="40" Margin="530,260,0,0" VerticalAlignment="Top" Width="50" isEnabled="False"/>
        <Label Content="Empresa : " HorizontalAlignment="Left" Margin="280,160,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtRucEmp" HorizontalAlignment="Left" Height="40" Margin="370,160,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250" FontSize="16" VerticalContentAlignment="Center"/>
        <Button x:Name="btnBuscar" Margin="622,160,0,0" Width="56" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Foreground="White" Click="btnBuscar_Click">
            <Button.Background>
                <SolidColorBrush Color="#5bc0de" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
            </StackPanel>
        </Button>
        
        <Grid HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,325,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,325,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
