<UserControl x:Class="TreskelRest.frms.ctls.ctlMovimientoCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Width="Auto" Height="Auto" Margin="25">
        <Label x:Name="label" Content="Fecha:" HorizontalAlignment="Left" Margin="5,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <DatePicker x:Name="dtpDesde" Height="40" Width="170" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="65,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <DatePicker x:Name="dtpHasta" Height="40" Width="170" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="246,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Label Content="Tipo:" HorizontalAlignment="Left" Margin="430,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.276,0.308" Height="40"  FontSize="16" VerticalContentAlignment="Center" />
        <ComboBox x:Name="cboTipo" Height="40" Width="150" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="480,10,0,0" VerticalContentAlignment="Center" FontSize="18">
            <ComboBoxItem Tag="" FontSize="18" Height="40" VerticalContentAlignment="Center" IsSelected="True">-- Todos --</ComboBoxItem>
            <ComboBoxItem Tag="I" FontSize="18" Height="40" VerticalContentAlignment="Center">Ingreso</ComboBoxItem>
            <ComboBoxItem Tag="E" FontSize="18" Height="40" VerticalContentAlignment="Center">Egreso</ComboBoxItem>
        </ComboBox>
        <Button x:Name="btnBuscar" Margin="640,9,0,0" Width="100" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Foreground="White" Click="btnBuscar_Click">
            <Button.Background>
                <SolidColorBrush Color="#5bc0de" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Buscar</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btnSalir" Margin="60,9,0,0" Width="110" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Foreground="White" Click="btnSalir_Click">
            <Button.Background>
                <SolidColorBrush Color="#d9534f" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/cancel.png" Width="30" Height="30" />
                <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
            </StackPanel>
        </Button>
        <DataGrid x:Name="Resultado" Width="Auto" Height="Auto" Margin="0,70,0,0"
                  AlternationCount="2" AlternatingRowBackground="Aquamarine"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  CanUserReorderColumns="True" CanUserAddRows="False" IsReadOnly="True"
                  FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Acción" Width="80" >
                    <DataGridTemplateColumn.CellTemplate >
                        <DataTemplate>
                            <Grid>
                                <Button Width="70" Height="40" Margin="3" Background="Transparent" BorderBrush="Transparent" Click="Editar_Click" >
                                    <Image Source="../../images/edit.png" Width="30" Height="30" />
                                </Button>
                                <Button Width="70" Height="40" Margin="3" Background="Transparent" BorderBrush="Transparent" Click="Eliminar_Click" >
                                    <Image Source="../../images/delete.png" Width="30" Height="30" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="120" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding tipo}" Width="300" />
                <DataGridTextColumn Header="Detalle" Binding="{Binding detalle}" Width="200" />
                <DataGridTextColumn Header="Valor" Binding="{Binding valor}" Width="120" />
            </DataGrid.Columns>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Grid Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>
    </Grid>
</UserControl>
