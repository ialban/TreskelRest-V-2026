<UserControl x:Class="TreskelRest.frms.ctls.ctlEsperar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" d:DesignWidth="300" Height="175" >
    <Grid Background="Black">
        <Grid Margin="10, 10, 10, 10" Background="White">
            <ProgressBar HorizontalAlignment="Center" Height="18" Margin="0,101,0,0" VerticalAlignment="Top" Width="182" IsIndeterminate="True" />
            <Label x:Name="Mensaje" Content="Generando el reporte, espere..." HorizontalAlignment="Center" Height="34" Margin="0,25,0,0" VerticalAlignment="Top" Width="250" HorizontalContentAlignment="Center" FontSize="16"/>
        </Grid>
    </Grid>
</UserControl>
