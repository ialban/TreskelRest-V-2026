<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaFeriado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="380" d:DesignWidth="800">
    <Grid>
        <Label Content="Código : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="120,10,0,0" IsEnabled="False" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
        <Label Content="Descripción : " HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <TextBox x:Name="txtDescripcion" HorizontalAlignment="Left" Margin="120,70,0,0" IsEnabled="True" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="650" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="80"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
        <Label Content="Desde : " HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <DatePicker x:Name="desde" FontSize="16" Width="270" Height="40" Margin="120,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />
        <Label Content="Hasta : " HorizontalAlignment="Left" Margin="400,130,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <DatePicker x:Name="hasta" FontSize="16" Width="270" Height="40" Margin="500,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center"  CalendarStyle="{StaticResource styleCalendar}" />

        <Label Content="Aplica IVA Feriado : " HorizontalAlignment="Left" Margin="10,190,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <CheckBox x:Name="chkIvaFeriado" Margin="150,190,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsChecked="False">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Label Content="Activo : " HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top" Height="40" VerticalContentAlignment="Center" FontSize="16"/>
        <CheckBox x:Name="chkActivo" Margin="150,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsChecked="True">
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="3" ScaleY="3" />
            </CheckBox.LayoutTransform>
        </CheckBox>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="70" Width="290">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
