<UserControl x:Class="TreskelRest.frms.ctls.ctlInvAjus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid Width="Auto" Height="Auto" Margin="25">
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="140,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <Label Content="Producto:" FontSize="16" Height="40" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="cboProducto" FontSize="16" Height="40" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="99,10,0,0" VerticalAlignment="Top" Width="301"/>
                <Label Content="Unidad:" FontSize="16" Height="40" HorizontalAlignment="Left" Margin="10,72,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="cboUnidad" FontSize="16" Height="40" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="99,72,0,0" VerticalAlignment="Top" Width="301">
                    <ComboBoxItem Tag="U" Height="40" FontSize="16" VerticalContentAlignment="Center" IsSelected="True">Unidad</ComboBoxItem>
                    <ComboBoxItem Tag="Q" Height="40" FontSize="16" VerticalContentAlignment="Center">Quintal</ComboBoxItem>
                    <ComboBoxItem Tag="K" Height="40" FontSize="16" VerticalContentAlignment="Center">Kilos</ComboBoxItem>
                    <ComboBoxItem Tag="L" Height="40" FontSize="16" VerticalContentAlignment="Center">Libra</ComboBoxItem>
                    <ComboBoxItem Tag="G" Height="40" FontSize="16" VerticalContentAlignment="Center">Gramos</ComboBoxItem>
                    <ComboBoxItem Tag="O" Height="40" FontSize="16" VerticalContentAlignment="Center">Onzas</ComboBoxItem>
                    <ComboBoxItem Tag="P" Height="40" FontSize="16" VerticalContentAlignment="Center">Porción</ComboBoxItem>
                </ComboBox>
                <Label Content="Cantidad:" FontSize="16" Height="40" HorizontalAlignment="Left" Margin="10,134,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtCantidad" HorizontalAlignment="Left" Height="40" Margin="99,134,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="142" FontSize="16" VerticalContentAlignment="Center" MaxLength="6"/>
                <Label Content="Tipo:" FontSize="16" Height="40" HorizontalAlignment="Left" Margin="10,195,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="cboTipo" FontSize="16" Height="40" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="99,195,0,0" VerticalAlignment="Top" Width="301">
                    <ComboBoxItem Tag="I" IsSelected="True" VerticalContentAlignment="Center" Height="40">Ingreso</ComboBoxItem>
                    <ComboBoxItem Tag="E" VerticalContentAlignment="Center" Height="40">Egreso</ComboBoxItem>
                </ComboBox>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
