<UserControl x:Class="TreskelRest.frms.ctls.ctlDelivery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="500" Width="741">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Bottom" Height="60" HorizontalAlignment="Center">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            
            <Grid Margin="0,0,0,10">
                <Label Content="Identificación : " FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtNid" HorizontalAlignment="Left" Height="40" FontSize="16" Margin="125,30,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="207" MaxLength="20"/>
                <Button Margin="350,18,0,0" HorizontalAlignment="left" VerticalAlignment="Top" x:Name="btnBscCli" Width="65" Height="60" Click="btnBscCli_Click">
                    <StackPanel Orientation="Vertical">
                        <Image Source="../../images/find.png" Width="30" Height="30"/>
                        <Label Content="Buscar" />
                    </StackPanel>
                </Button>
                <Label Content="Cliente : " FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtNbr" HorizontalAlignment="Left" Height="40" FontSize="16" Margin="127,90,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="463" MaxLength="50" CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
                <Label Content="Dirección : " FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,158,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="txtDir" HorizontalAlignment="Left" Height="60" FontSize="16" Margin="127,148,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="463" MaxLength="100"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
                <Button x:Name="btnBorrarDir" Margin="600,153,0,0" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="50" Click="btnBorrarDir_Click">
                    <StackPanel Orientation="Vertical">
                        <Image Source="../../images/delete.png" Width="30" Height="30"/>
                    </StackPanel>
                </Button>
                <Label Content="Teléfono : " FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,228,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.543,0.397"/>
                <TextBox x:Name="txtTlf" HorizontalAlignment="Left" Height="40" FontSize="16" Margin="127,228,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="463" MaxLength="20"/>
                <Button x:Name="btnBorrarTlf" Margin="600,223,0,0" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="50" Click="btnBorrarTlf_Click">
                    <StackPanel Orientation="Vertical">
                        <Image Source="../../images/delete.png" Width="30" Height="30"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnTlfCli" Margin="658,223,0,0" HorizontalAlignment="left" VerticalAlignment="Top" Width="50" Height="50" Click="btnTlfCli_Click">
                    <StackPanel Orientation="Vertical">
                        <Image Source="../../images/find.png" Width="30" Height="30"/>
                    </StackPanel>
                </Button>
                <Label Content="Referencia : " FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,297,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.543,0.397"/>
                <TextBox x:Name="txtRef" HorizontalAlignment="Left" Height="40" FontSize="16" Margin="127,297,0,0" VerticalContentAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="463" MaxLength="50"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>
                <Button x:Name="btnBorrarRef" Margin="600,293,0,0" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="50" Click="btnBorrarRef_Click">
                    <StackPanel Orientation="Vertical">
                        <Image Source="../../images/delete.png" Width="30" Height="30"/>
                    </StackPanel>
                </Button>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
