<UserControl x:Class="TreskelRest.frms.ctls.ctlBackup" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:timepicker="clr-namespace:LibControls.timepicker;assembly=LibControls" 
             mc:Ignorable="d" Background="White"
             d:DesignHeight="650" d:DesignWidth="900">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="70" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" Margin="10,10,140,0" VerticalAlignment="Top" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel DockPanel.Dock="Left" Width="220" Height="Auto">
            <StackPanel.Background>
                <ImageBrush ImageSource="../../images/configBackup.png" />
            </StackPanel.Background>
        </StackPanel>
        <Grid>
            <GroupBox Header="Programación del Backup" FontSize="16"  HorizontalAlignment="Left" Height="210" Margin="10,10,0,0" VerticalAlignment="Top" Width="410">
                <StackPanel Orientation="Vertical" Margin="10,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkPrimer" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="-0.219,0.567" IsChecked="True" Checked="chkPrimer_Checked" Unchecked="chkPrimer_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Hora Inicio 1:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                        <timepicker:ctlTimePicker x:Name="hInicio1" Margin="50,10,0,10" VerticalAlignment="Top" IsEnabled="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkSegundo" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="-0.219,0.567" Checked="chkSegundo_Checked" Unchecked="chkSegundo_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Hora Inicio 2:" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Top" FontSize="16"/>
                        <timepicker:ctlTimePicker x:Name="hInicio2" Margin="50,10,0,10" VerticalAlignment="Top" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkTercero" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="-0.219,0.567" Checked="chkTercero_Checked" Unchecked="chkTercero_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Hora Inicio 3:" HorizontalAlignment="Left" Margin="10,10,0,10" VerticalAlignment="Top" FontSize="16"/>
                        <timepicker:ctlTimePicker x:Name="hInicio3" Margin="50,10,0,10" VerticalAlignment="Top" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Ejecución por demanda" FontSize="16"  HorizontalAlignment="Left" Height="210" Margin="430,10,0,0" VerticalAlignment="Top" Width="240">
                <StackPanel Orientation="Vertical">
                    <TextBlock TextAlignment="Justify" TextWrapping="Wrap" Margin="5,5,5,5">Ejecuta el proceso de backup de manera inmedianta, para poder descargarlo en el computador cliente.</TextBlock>
                    <Button x:Name="btnBackup" Margin="5,5,5,5" VerticalAlignment="Top" Height="40" Foreground="White" FontSize="16" Background="LightBlue" Click="btnBackup_Click">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                            </StackPanel.Resources>
                            <Image Source="../../images/backup.png" Width="30" Height="30" />
                            <TextBlock VerticalAlignment="Center"><Run Text="Iniciar Backup"/></TextBlock>
                        </StackPanel>
                    </Button>
                    <ProgressBar x:Name="pgProgreso" Height="10" Value="0" Margin="5,0,5,0"></ProgressBar>
                    <TextBlock x:Name="txtProgreso" Text="" FontSize="12" Margin="5,5,5,0" TextAlignment="Center"></TextBlock>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Generación de archivos de Backup" FontSize="16"  HorizontalAlignment="Left" Height="90" Margin="10,230,0,0" VerticalAlignment="Top" Width="660">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <Label Content="Cantidad de archivos :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16"/>
                    <ComboBox x:Name="cboCnt" HorizontalAlignment="Left" Margin="100,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" VerticalContentAlignment="Center">
                        <ComboBoxItem Tag="1" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="1"/>
                        <ComboBoxItem Tag="2" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="2"/>
                        <ComboBoxItem Tag="3" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="3"/>
                        <ComboBoxItem Tag="4" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="4" IsSelected="True" />
                        <ComboBoxItem Tag="5" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="5"/>
                        <ComboBoxItem Tag="6" Height="40" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" FontSize="16" Content="6"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Comunicación y Transferencia" FontSize="16"  HorizontalAlignment="Left" Height="230" Margin="10,330,0,0" VerticalAlignment="Top" Width="660">
                <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Height="60">
                        <Label Content="Envía mail de aviso:" FontSize="16" Height="40" Width="180" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <CheckBox x:Name="chkMail" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                        <Label Content="Subir a la nube:" FontSize="16" Height="40" Width="180" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <CheckBox x:Name="chkUpload" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="-0.219,0.567" Checked="chkUpload_Checked" Unchecked="chkUpload_Unchecked">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="3" ScaleY="3" />
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Height="70">
                        <Label Content="URL Servidor de respaldos:" FontSize="16" Height="40" Width="210" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                        <TextBox x:Name="txtUrlServer" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="54" Margin="0,10,0,0" Text="" VerticalAlignment="Top" Width="430"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Height="80">
                        <Label Content="Usuario:" FontSize="16" Height="40" Width="80" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" VerticalContentAlignment="Center" />
                        <TextBox x:Name="txtUser" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Right" Height="54" Margin="0,10,0,0" Text="" VerticalAlignment="Top" Width="200"/>
                        <Label Content="Contraseña:" FontSize="16" Height="40" Width="100" Margin="10,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" VerticalContentAlignment="Center" />
                        <PasswordBox x:Name="txtClave" FontSize="16" VerticalContentAlignment="Center" HorizontalAlignment="Right" Height="54" Margin="0,10,0,0" Password="" VerticalAlignment="Top" Width="200"/>
                    </StackPanel>
                    
                    
                </StackPanel>
            </GroupBox>

            
        </Grid>
    </DockPanel>
</UserControl>
