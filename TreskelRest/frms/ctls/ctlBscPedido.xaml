<UserControl x:Class="TreskelRest.frms.ctls.ctlBscPedido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d"  Background="White"
             d:DesignHeight="400" d:DesignWidth="860">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="80">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </StackPanel.Resources>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="btnCancelar" Margin="3,3,3,0" HorizontalAlignment="Left" Background="LightCoral" VerticalAlignment="Top" Height="70" Width="70" Click="btnCancelar_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/cancel.png" Width="30" Height="30" />
                            <Label Content="Cancelar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAceptar" Margin="3,3,3,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="70" Width="70" Click="btnAceptar_Click">
                        <Button.Background>
                            <SolidColorBrush Color="#5cb85c" />
                        </Button.Background>
                        <StackPanel Orientation="Vertical">
                            <Image Source="../../images/accept.png" Width="30" Height="30" />
                            <Label Content="Aceptar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnClear" HorizontalAlignment="Left" Margin="20,3,3,0" VerticalAlignment="Top"  Height="70" Width="70" Click="btnClear_Click">
                        <Image Source="../../images/clear.png" Width="40" Height="40" />
                    </Button>
                    <Button x:Name="btnBack" HorizontalAlignment="Left" Margin="3,3,3,0" VerticalAlignment="Top" Width="70" Height="70" Click="btnBack_Click">
                        <Image Source="../../images/back.png" Width="40" Height="40" />
                    </Button>
                </StackPanel>

            </Grid>
            <Grid>
                <Grid x:Name="gridPe" Visibility="Visible">
                    <TextBox x:Name="txtPEfectivo" FontSize="16" VerticalContentAlignment="Center" Text="" Width="190" Height="40" Margin="16,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <Grid Width="190" Height="220" HorizontalAlignment="Left" Margin="16,55,544,45">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="button7" Content="7" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button8" Content="8" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button9" Content="9" FontSize="16" Width="60" Height="55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="button4" Content="4" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button5" Content="5" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button6" Content="6" FontSize="16" Width="60" Height="55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="button1" Content="1" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button2" Content="2" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="button3" Content="3" FontSize="16" Width="60" Height="55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnLast" FontSize="16" Width="60" Height="55" Click="btnLast_Click">
                                    <Image Source="../../images/ultimo.png" Width="30" Height="30" />
                                </Button>
                                <Button x:Name="button0" Content="0" FontSize="16" Width="60" Height="55"/>
                                <Button x:Name="btnBuscar" FontSize="16" Width="60" Height="55" Click="btnBuscar_Click">
                                    <Image Source="../../images/find.png" Width="30" Height="30" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="211,10,10,4">
                        <DataGrid x:Name="Resultado" Width="Auto" Height="Auto" Margin="0,0,0,0"
                              AlternationCount="2" AlternatingRowBackground="Aquamarine"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" 
                              CanUserReorderColumns="False" CanUserAddRows="False"
                              FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" 
                              AutoGenerateColumns="False" 
                              SelectionChanged="Resultado_SelectionChanged" 
                              IsReadOnly="True"
                            >
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar">
                                    <Style.Triggers>
                                        <Trigger Property="Orientation" Value="Vertical">
                                            <Setter Property="Width" Value="30"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="80" >
                                    <DataGridTemplateColumn.CellTemplate >
                                        <DataTemplate>
                                            <Grid>
                                                <Image Source="{Binding imagen}" Width="30" Height="30" Margin="8" />
                                                <!--<Button Width="70" Height="40" Margin="3" Background="Transparent" BorderBrush="Transparent" >

                                                </Button>-->
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Secuencial" Binding="{Binding ventscl}" Width="110" />
                                <DataGridTextColumn Header="Pedido" Binding="{Binding codigo}" Width="110" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding tipo}" Width="80" CellStyle="{StaticResource CentroCell}" />
                                <DataGridTextColumn Header="Mesa" Binding="{Binding mesa}" Width="100" CellStyle="{StaticResource CentroCell}" />
                                <DataGridTextColumn Header="Fact.Elec" Binding="{Binding etdofac}" Width="100" CellStyle="{StaticResource CentroCell}" />
                            </DataGrid.Columns>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
