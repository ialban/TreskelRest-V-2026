<UserControl x:Class="TreskelRest.frms.ctls.ctlVenta"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d"  Background="White" 
             d:DesignHeight="500" d:DesignWidth="1500">
    <DockPanel>
        <DockPanel.Resources>
            <Style TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="3"/>
            </Style>
        </DockPanel.Resources>

        <Grid DockPanel.Dock="Right" Width="430">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="127">
                    <GroupBox Header="Cliente"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Vertical">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="1"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Resources>
                                    <Style TargetType="{x:Type Button}">
                                        <Setter Property="Margin" Value="3"/>
                                    </Style>
                                </StackPanel.Resources>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="N° Id : " Width="55" FontSize="12" Height="30" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCedula" Width="154" FontSize="16" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                        <Button x:Name="btnBorrar" Margin="0" Width="50" Click="btnBorrar_Click">
                                            <StackPanel Orientation="Vertical">
                                                <Image Source="../../images/delete.png" Width="30" Height="30"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Cliente : " Width="55" FontSize="12" HorizontalContentAlignment="Left" />
                                        <TextBox x:Name="txtCliente" IsEnabled="False" Width="205" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="btnBscCli" Width="65" Height="60" Click="btnBscCli_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image Source="../../images/find.png" Width="30" Height="30"/>
                                        <Label Content="Buscar" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnCliFnl" Width="65" Height="60" Click="btnCliFnl_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image Source="../../images/client.png" Width="30" Height="30"/>
                                        <Label Content="Cli. Final" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Email : " Width="57" FontSize="12" HorizontalContentAlignment="Left" />
                                <TextBox x:Name="txtEmail" IsEnabled="False" Width="305" FontSize="13" Text="" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                <Button x:Name="btnEditClie" Width="40" Height="30" Click="btnEditClie_Click">
                                    <StackPanel Orientation="Vertical">
                                        <Image Source="../../images/edit.png" Width="24" Height="24"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid DockPanel.Dock="Bottom" Height="179">
                    <GroupBox Header="Detalle" FontSize="16"  BorderBrush="Black" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Sub sin Iva:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    <TextBox x:Name="txtSubTot0" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Recibido:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" />
                                    <TextBox x:Name="txtRecibido" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Cambio:" Width="90" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtCambio" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Sub con Iva:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtSubTot" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Descuento:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtDscto" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Iva:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtIva" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Total:" Width="100" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="left" />
                                    <TextBox x:Name="txtTotal" Width="100" IsEnabled="False" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
                <Grid>
                    <DataGrid x:Name="dgvPedd" Width="Auto" Height="Auto" Margin="0,0,0,0"
                            AlternationCount="2" AlternatingRowBackground="Aquamarine"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" 
                            CanUserReorderColumns="False" CanUserAddRows="False" IsEnabled="False" IsReadOnly="True"
                            FontSize="12" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="70" Visibility="Hidden" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding producto}" Width="210"  />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="70" CellStyle="{StaticResource CentroCell}" />
                            <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="100" CellStyle="{StaticResource DerechaCell}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding total}" Width="50" CellStyle="{StaticResource CentroCell}" Visibility="Hidden" />
                            <DataGridTextColumn Header="IVA" Binding="{Binding iva}" Width="100" Visibility="Hidden" />
                        </DataGrid.Columns>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="White"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Grid Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Grid>
        <Grid DockPanel.Dock="Top" Height="170" Width="Auto" Margin="5,5,5,5">
            <GroupBox Header="Acciones" BorderBrush="Black" BorderThickness="2" Margin="0,0,0,0" >
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                    </StackPanel.Resources>
                    <Grid Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="1,1,3,1">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Margin" Value="3"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="btnSalir" Width="75" Height="65" Background="LightCoral" Click="btnSalir_Click">
                                <StackPanel>
                                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                                    <Label Content="Salir" FontSize="12" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnBscPedd" Width="75" Height="65" Margin="5,0,3,0" Background="Beige" Click="btnBscPedd_Click">
                                <StackPanel>
                                    <Image Source="../../images/findbill.png" Width="30" Height="30" />
                                    <Label Content="Pedido" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnCancelar" IsEnabled="False" Width="75" Height="65" Background="Beige" Margin="5,0,3,0" Click="btnCancelar_Click">
                                <StackPanel>
                                    <Image Source="../../images/undo.png" Width="30" Height="30" />
                                    <Label Content="Cancelar" FontSize="14" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnFacturar" IsEnabled="False" Width="75" Height="65" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnFacturar_Click">
                                <StackPanel>
                                    <Image Source="../../images/tobill.png" Width="30" Height="30" />
                                    <Label Content="Facturar" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnAnlFact" Width="75" Height="65" IsEnabled="False" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnAnlFact_Click">
                                <StackPanel>
                                    <Image Source="../../images/cancelbill.png" Width="30" Height="30" />
                                    <Label Content="Anular" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDivFact" IsEnabled="False" Width="75" Height="65" Background="BlanchedAlmond" Margin="3,0,3,0" Click="btnDivFact_Click">
                                <StackPanel>
                                    <Image Source="../../images/cutbill.png" Width="30" Height="30" />
                                    <Label Content="Separar" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnImpFact" IsEnabled="False" Width="75" Height="65"  Margin="3,0,3,0" Background="BlanchedAlmond" Click="btnImpFact_Click">
                                <StackPanel>
                                    <Image Source="../../images/printer.png" Width="30" Height="30" />
                                    <Label Content="Imprimir" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnFact" IsEnabled="False" Width="75" Height="65"  Margin="3,0,15,0" Visibility="Hidden" Background="BlanchedAlmond" Click="btnFact_Click">
                                <StackPanel>
                                    <Image Source="/TreskelRest;component/images/printBill.png" Width="30" Height="30" />
                                    <Label Content="Imprimir" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,95,0">
                            <ToggleButton x:Name="btnAutomata" Width="80" Height="57" Background="GhostWhite" HorizontalAlignment="Right" Checked="btnAutomata_Checked" Unchecked="btnAutomata_Unchecked" IsChecked="True">
                                <StackPanel>
                                    <Image Source="../../images/automata.png" Width="35" Height="35" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,3,0">
                            <ToggleButton x:Name="btnCajero" Width="80" Height="57" Background="GhostWhite" HorizontalAlignment="Right" Checked="btnCajero_Checked" Unchecked="btnCajero_Unchecked">
                                <StackPanel>
                                    <Image Source="../../images/cajero.png" Width="23" Height="23" />
                                    <Label Content="Cajero" FontSize="12" />
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock x:Name="Mesero" FontSize="11" Height="15" Width="70" TextWrapping="Wrap" Foreground="Blue" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="1,1,1,1">
                            <StackPanel Orientation="Horizontal" Width="630" Margin="0,0,0,0">
                                <Button x:Name="btnActualizar" Width="75" Height="65" Margin="3,0,3,0" Background="Beige" Click="btnActualizar_Click">
                                    <StackPanel>
                                        <Image Source="../../images/update.png" Width="30" Height="30" />
                                        <Label Content="Actualizar" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnToDelivery" IsEnabled="False" Width="75" Height="65" Margin="5,0,3,0" Background="Beige" Click="btnToDelivery_Click" >
                                    <StackPanel>
                                        <Image Source="../../images/delivery.png" Width="30" Height="30" />
                                        <Label Content="Domicilio" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnToPay" IsEnabled="False" Width="75" Height="65" Background="GreenYellow" Margin="5,0,3,0" Click="btnToPay_Click">
                                    <StackPanel>
                                        <Image Source="../../images/topay.png" Width="30" Height="30" />
                                        <Label Content="Pago" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnDescto" IsEnabled="False" Width="75" Height="65" Margin="3,0,3,0" Background="GreenYellow" Click="btnDescto_Click">
                                    <StackPanel>
                                        <Image Source="../../images/discount.png" Width="30" Height="30" />
                                        <Label Content="Descuento" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btngift" IsEnabled="False" Width="75" Height="65" Margin="3,0,3,0" Background="GreenYellow" Click="btngift_Click">
                                    <StackPanel>
                                        <Image Source="../../images/gift.png" Width="30" Height="30" />
                                        <Label Content="Cortesía" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnDelFact" IsEnabled="False" Width="75" Height="65"  Margin="3,0,3,0" Background="BlanchedAlmond" Click="btnDelFact_Click">
                                    <StackPanel>
                                        <Image Source="../../images/delete.png" Width="30" Height="30" />
                                        <Label Content="Eliminar" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnFactElec" IsEnabled="False" Width="75" Height="65"  Margin="3,0,3,0" Background="DeepSkyBlue" Click="btnFactElec_Click">
                                    <StackPanel>
                                        <Image Source="../../images/Faturaelect.png" Width="30" Height="30" />
                                        <Label Content="Fact Elect" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnProforma" Visibility="Hidden" IsEnabled="False" Width="75" Height="65" Margin="3,0,3,0" Background="BurlyWood" Click="btnProforma_Click">
                                    <StackPanel>
                                        <Image Source="../../images/proforma.png" Width="30" Height="30" />
                                        <Label Content="Proforma" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnImpPro" Visibility="Hidden" IsEnabled="False" Width="75" Height="65"  Margin="3,0,15,0" Background="BurlyWood" Click="btnImpPro_Click">
                                    <StackPanel>
                                        <Image Source="../../images/printer.png" Width="30" Height="30" />
                                        <Label Content="Imprimir" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="lSmall" Orientation="Vertical" HorizontalAlignment="Right" Margin="0,3,0,3" Visibility="Visible">
                            <!--<StackPanel Orientation="Vertical">-->
                            <Grid Height="16" Width="80" Margin="0,0,0,0">
                                    <Rectangle Width="80" Height="14" Fill="LightSalmon"/>
                                    <TextBlock Text="Facturado" FontSize="10" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                                <Grid Height="16" Width="80" Margin="0,1,0,0">
                                    <Rectangle Width="80" Height="14" Fill="LightBlue"/>
                                    <TextBlock Text="Separado" FontSize="10" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                                <Grid Height="16" Width="80" Margin="0,1,0,0">
                                    <Rectangle Width="80" Height="14" Fill="LightGreen"/>
                                    <TextBlock Text="Anulado" FontSize="10" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                                <Grid Height="16" Width="80" Margin="0,1,0,0">
                                    <Rectangle Width="80" Height="14" Fill="LightGray" />
                                    <!--<Rectangle.Fill>
                                            <SolidColorBrush Color="LightGray" />
                                    </Rectangle.Fill>-->

                                <TextBlock Text="Por facturar" FontSize="10" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                            <!--</StackPanel>-->
                        </StackPanel>
                        <StackPanel x:Name="lNormal" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,3" Visibility="Hidden">
                            <StackPanel Orientation="Vertical">
                                <Grid Height="16" Width="80">
                                    <Rectangle Width="80" Height="16" Fill="LightSalmon"/>
                                    <TextBlock Text="Facturado" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                                <Grid Height="16" Width="80">
                                    <Rectangle Width="80" Height="16" Fill="LightBlue"/>
                                    <TextBlock Text="Separado" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Vertical">
                                <Grid Height="16" Width="80">
                                    <Rectangle Width="80" Height="16" Fill="LightGreen"/>
                                    <TextBlock Text="Anulado" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                                <Grid Height="16" Width="80">
                                    <Rectangle Width="80" Height="16">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="LightGray" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock Text="Por facturar" Margin="5,0" FontWeight="Bold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                    <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="30" />
                            <Setter Property="MinHeight" Value="30" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="MinWidth" Value="30" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Resources>
            <WrapPanel x:Name="pedidoContainer" Width="Auto" Height="Auto" Margin="3,3,3,3" FlowDirection="LeftToRight" VerticalAlignment="Top" Orientation="Horizontal" >

            </WrapPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
