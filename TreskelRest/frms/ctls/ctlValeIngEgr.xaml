<UserControl x:Class="TreskelRest.frms.ctls.ctlValeIngEgr"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="390" d:DesignWidth="570">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="70" VerticalAlignment="Bottom" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#5cb85c" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" VerticalAlignment="Center" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#d9534f" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid>
            <Label Content="Secuencia" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="10,10,0,0"></Label>
            <TextBox x:Name="txtSecuencia" Height="40" Width="150" FontSize="16" IsReadOnly="true" VerticalContentAlignment="Center" Margin="115,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></TextBox>
            <Label Content="Caja" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,68,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
            <Label Content="Fecha" VerticalAlignment="Top" Height="40" Width="100" FontSize="16" FontWeight="Bold" Margin="287,10,0,0" HorizontalAlignment="Left"></Label>
            <DatePicker x:Name="dtpFecha" Height="40" Width="180" FontSize="16" CalendarStyle="{StaticResource styleCalendar}" VerticalContentAlignment="Center" Margin="360,11,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Label x:Name="lblCaja" Content="" Height="40" Width="430" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Margin="115,68,0,0" Background="LightGray"></Label>
            <Label Content="Detalle" Height="40" Width="100" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="10,124,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
            <Button x:Name="btnMotivos" Width="40" Content="..." Height="40" Margin="505,124,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="White" Click="btnMotivos_Click">
                <Button.Background>
                    <SolidColorBrush Color="YellowGreen" />
                </Button.Background>
            </Button>
            <TextBox x:Name="txtDetalle" Height="90" FontSize="16" Width="380" Margin="115,124,0,0" MaxLines="2" VerticalAlignment="Top" HorizontalAlignment="Left"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps" ></TextBox>
            <Label Content="Valor" Height="40" Width="100" FontSize="16" FontWeight="Bold" Margin="10,230,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"></Label>
            <TextBox x:Name="txtValor" Height="40" Width="200" FontSize="16" VerticalContentAlignment="Center" Margin="115,230,0,0" MaxLength="8" VerticalAlignment="Top" HorizontalAlignment="Left"></TextBox>
        </Grid>
    </DockPanel>
</UserControl>
