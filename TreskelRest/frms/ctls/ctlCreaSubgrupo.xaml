<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaSubgrupo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" 
             Background="White" d:DesignWidth="700" Height="380">
    <Grid>
        <ComboBox x:Name="cboGrupo" HorizontalAlignment="Left" Margin="116,73,0,0" VerticalAlignment="Top" Width="299" Height="40" VerticalContentAlignment="Center" FontSize="16">
            
        </ComboBox>
        <Label x:Name="label1" Content="Código : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="116,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" Height="40" FontSize="16" VerticalContentAlignment="Center" MaxLength="4"/>
        <Label x:Name="Grupo" Content="Grupo : " HorizontalAlignment="Left" Margin="10,73,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <Label x:Name="label4" Content="Subgrupo : " HorizontalAlignment="Left" Margin="9,130,0,0" VerticalAlignment="Top" FontSize="16" Height="40" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txtNombre" HorizontalAlignment="Left" Height="40" Margin="116,130,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="562" FontSize="16" VerticalContentAlignment="Center" MaxLength="100"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps"/>

        <Grid HorizontalAlignment="Center">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,325,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,325,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
