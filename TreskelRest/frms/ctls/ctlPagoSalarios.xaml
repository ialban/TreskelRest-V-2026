<UserControl x:Class="TreskelRest.frms.ctls.ctlPagoSalarios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls" 
             xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="890">
    <Grid>
        <Label Content="Empleado : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <TextBox x:Name="txtNid" HorizontalAlignment="Left" Margin="100,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="250" Height="40" 
                 FontSize="16" VerticalContentAlignment="Center" MaxLength="20" KeyDown="txtNid_KeyDown"/>
        <Button x:Name="btnBuscar" HorizontalAlignment="Left" Margin="352,10,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnBuscar_Click">
            <Button.Background>
                <SolidColorBrush Color="LightBlue" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/find.png" Width="30" Height="30" />
            </StackPanel>
        </Button>
        <Button x:Name="btnClsEmp" HorizontalAlignment="Left" Margin="405,10,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnClsEmp_Click">
            <Button.Background>
                <SolidColorBrush Color="LightCyan" />
            </Button.Background>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Image}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="3"/>
                    </Style>
                </StackPanel.Resources>
                <Image Source="../../images/clear.png" Width="30" Height="30" />
            </StackPanel>
        </Button>

        <ToggleButton x:Name="btnCajero" Width="80" Height="70" Background="GhostWhite" Margin="0,10,10, 0" VerticalAlignment="Top" HorizontalAlignment="Right" Checked="btnCajero_Checked" Unchecked="btnCajero_Unchecked">
            <StackPanel>
                <Image Source="../../images/cajero.png" Width="30" Height="30" />
                <Label Content="Cajero" FontSize="14" />
            </StackPanel>
        </ToggleButton>
        
        <Label x:Name="lblNid" Content="No hay Empleado Seleccionado" Tag="" Foreground="Gray" HorizontalAlignment="Left" Margin="10,60,0,0" Width="700" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
        <Separator Margin="0,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
        <GroupBox x:Name="grbDatos" Header="Datos del pago" Margin="5,120,5,0" Width="880" Height="450" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid>
                <Label Content="Origen : " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                            <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Height" Value="30" />
                                    <Setter Property="MinHeight" Value="30" />
                                </Trigger>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="Width" Value="30" />
                                    <Setter Property="MinWidth" Value="30" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Resources>
                    <WrapPanel x:Name="OpcOrigen" Margin="100, 5, 0, 0" Height="80" Width="560" VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style TargetType="{x:Type ToggleButton}">
                                <Setter Property="Margin" Value="2"/>
                            </Style>
                        </WrapPanel.Resources>
                    </WrapPanel>
                </ScrollViewer>
                
                <Label Content="Año : " HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <spinner:ctlSpinner x:Name="txtAnio" HorizontalAlignment="Left" Margin="100,110,0,0" VerticalAlignment="Top" Grid.Column="2" Height="40" Width="160"/>

                <Label Content="Mes de : " HorizontalAlignment="Left" Margin="280,110,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <ComboBox x:Name="cboMes" Width="150" Height="40" Margin="350,110,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" 
                          FontSize="16"  VerticalContentAlignment="Center" SelectionChanged="cboMes_SelectionChanged">
                    <ComboBoxItem Tag="E" FontSize="16" Height="40" VerticalContentAlignment="Center">Enero</ComboBoxItem>
                    <ComboBoxItem Tag="F" FontSize="16" Height="40" VerticalContentAlignment="Center">Febrero</ComboBoxItem>
                    <ComboBoxItem Tag="M" FontSize="16" Height="40" VerticalContentAlignment="Center">Marzo</ComboBoxItem>
                    <ComboBoxItem Tag="A" FontSize="16" Height="40" VerticalContentAlignment="Center">Abril</ComboBoxItem>
                    <ComboBoxItem Tag="Y" FontSize="16" Height="40" VerticalContentAlignment="Center">Mayo</ComboBoxItem>
                    <ComboBoxItem Tag="J" FontSize="16" Height="40" VerticalContentAlignment="Center">Junio</ComboBoxItem>
                    <ComboBoxItem Tag="L" FontSize="16" Height="40" VerticalContentAlignment="Center">Julio</ComboBoxItem>
                    <ComboBoxItem Tag="T" FontSize="16" Height="40" VerticalContentAlignment="Center">Agosto</ComboBoxItem>
                    <ComboBoxItem Tag="S" FontSize="16" Height="40" VerticalContentAlignment="Center">Septiembre</ComboBoxItem>
                    <ComboBoxItem Tag="O" FontSize="16" Height="40" VerticalContentAlignment="Center">Octubre</ComboBoxItem>
                    <ComboBoxItem Tag="N" FontSize="16" Height="40" VerticalContentAlignment="Center">Noviembre</ComboBoxItem>
                    <ComboBoxItem Tag="D" FontSize="16" Height="40" VerticalContentAlignment="Center">Diciembre</ComboBoxItem>
                </ComboBox>
                <Button x:Name="btnRefresh" HorizontalAlignment="Left" Margin="502,110,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnRefresh_Click">
                    <Button.Background>
                        <SolidColorBrush Color="LightCyan" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/undo.png" Width="30" Height="30" />
                    </StackPanel>
                </Button>

                <Label x:Name="lblDia" Content="Día: " HorizontalAlignment="Left" Margin="570,110,0,0" VerticalAlignment="Top" FontSize="16" 
                       VerticalContentAlignment="Center" Height="40" Visibility="Hidden"/>
                <spinner:ctlSpinner x:Name="txtDia" HorizontalAlignment="Left" Margin="665,110,0,0" VerticalAlignment="Top" 
                                    Grid.Column="2" Height="40" Width="160" Visibility="Hidden"/>

                <Label Content="Salario : " HorizontalAlignment="Left" Margin="570,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <Label Content="Dólares" HorizontalAlignment="Left" Margin="665,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtSalario" HorizontalAlignment="Left" Margin="730,160,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20" IsReadOnly="True" Foreground="Gray" 
                         HorizontalContentAlignment="Right" Padding="0,0,10,0"/>

                <Label Content="Motivo : " HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                
                <Label Content="Pago Total" HorizontalAlignment="Left" Margin="100,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbPagoTotal" Margin="190,160,0,0" GroupName="motivos" VerticalAlignment="Top" HorizontalAlignment="Left"  IsChecked="True"
                             Checked="SeleccionMotivo_Checked">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>

                <Label Content="Pago Parcial" HorizontalAlignment="Left" Margin="250,160,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <RadioButton x:Name="rbPagoParcial" Margin="360,160,0,0" GroupName="motivos" VerticalAlignment="Top" HorizontalAlignment="Left"
                             Checked="SeleccionMotivo_Checked">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" />
                    </RadioButton.LayoutTransform>
                </RadioButton>

                <Label Content="Descuento : " HorizontalAlignment="Left" Margin="570,210,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <Label Content="Dólares" HorizontalAlignment="Left" Margin="665,210,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtDescuento" HorizontalAlignment="Left" Margin="730,210,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20" IsReadOnly="True" Foreground="Gray"
                         HorizontalContentAlignment="Right" Padding="0,0,10,0"/>

                <Label Content="Valor : " HorizontalAlignment="Left" Margin="10,210,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <Label Content="Dólares" HorizontalAlignment="Left" Margin="100,210,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtValor" HorizontalAlignment="Left" Margin="165,210,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20"/>
                <Button x:Name="btnClsVal" HorizontalAlignment="Left" Margin="285,210,0,0" VerticalAlignment="Top" Width="50" Height="40" Foreground="White" FontSize="16" Click="btnClsVal_Click">
                    <Button.Background>
                        <SolidColorBrush Color="LightCyan" />
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/clear.png" Width="30" Height="30" />
                    </StackPanel>
                </Button>

                <Label Content="Saldo : " HorizontalAlignment="Left" Margin="570,260,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <Label Content="Dólares" HorizontalAlignment="Left" Margin="665,260,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtSaldo" HorizontalAlignment="Left" Margin="730,260,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20" IsReadOnly="True" Foreground="Gray" HorizontalContentAlignment="Right"
                         Padding="0,0,10,0" />

                <Label Content="Saldos Pre.: " HorizontalAlignment="Left" Margin="570,320,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40"/>
                <Label Content="Dólares" HorizontalAlignment="Left" Margin="665,320,0,0" VerticalAlignment="Top" FontSize="16" VerticalContentAlignment="Center" Height="40" 
                       BorderBrush="Gray" BorderThickness="1" Background="Gray" Foreground="White"/>
                <TextBox x:Name="txtSaldoPrev" HorizontalAlignment="Left" Margin="730,320,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="120" Height="40" 
                         FontSize="16" VerticalContentAlignment="Center" MaxLength="20" IsReadOnly="True" Foreground="White" Background="LightSalmon" 
                         HorizontalContentAlignment="Right" Padding="0,0,10,0"/>
            </Grid>
        </GroupBox>
        <Grid Margin="0,10,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="60" Width="280">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
