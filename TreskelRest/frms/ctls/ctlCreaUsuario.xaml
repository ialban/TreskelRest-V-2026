<UserControl x:Class="TreskelRest.frms.ctls.ctlCreaUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="570" d:DesignWidth="900">
    <Grid>
        <TabControl x:Name="tabControl" Width="880" Height="500" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top">
            <TabItem Header="Opciones Generales" FontSize="16" Height="50" Margin="-2,0">
                <Grid>
                    <Label Content="Código:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtCodigo" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" Margin="120,10,0,0" IsReadOnly="True" />
                    <Label Content="Descripción:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtDescripcion" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="735" Margin="120,70,0,0"  CharacterCasing="Upper" Typography.Capitals="AllSmallCaps" />
                    <Label Content="Usuario:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtUsuario" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="250" Margin="120,130,0,0" MaxLength="10" />
                    <Label Content="Clave:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="400,130,0,0" VerticalAlignment="Top"/>
                    <PasswordBox x:Name="txtClave" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="250" Margin="500,130,0,0" MaxLength="10" />
                    <Label Content="Tipo:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,190,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="cboTipo" FontSize="16" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="120,190,0,0" Width="250" SelectionChanged="cboTipo_SelectionChanged">
                        <ComboBoxItem Tag="" IsSelected="True" Height="40" VerticalContentAlignment="Center">-- Seleccionar un tipo --</ComboBoxItem>
                        <ComboBoxItem Tag="M" Height="40" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../../images/mesero.png" Width="30" Height="30" />
                                <Label Content="Mesero (a)" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="C" Height="40" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../../images/cajero.png" Width="30" Height="30" />
                                <Label Content="Cajero (a)" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="S" Height="40" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../../images/administrador.png" Width="30" Height="30" />
                                <Label Content="Administrador (a)" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="A" Height="40" VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="../../images/developer.png" Width="30" Height="30" />
                                <Label Content="Técnico" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                    <Label Content="Empleado:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="400,190,0,0" VerticalAlignment="Top"/>
                    <ComboBox x:Name="cboEmpleado" FontSize="16" Height="40" VerticalContentAlignment="Center" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="500,190,0,0" Width="355">

                    </ComboBox>
                    <Label Content="Activo:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top"/>
                    <CheckBox x:Name="chkEstado" HorizontalAlignment="Left" Margin="113,250,0,0" VerticalAlignment="Top" IsChecked="True">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                    <GroupBox x:Name="grbTjtaClv" Margin="400,230,0,0" Width="450" Height="210" Header="Tarjeta de Coordenadas" VerticalAlignment="Top" HorizontalAlignment="Left"
                              Visibility="Visible">
                        <Grid Margin="0,0,0,0">
                            <Label x:Name="lblClvAprob" Content="Clave Aprobación:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="5,0,0,0" VerticalAlignment="Top"/>
                            <PasswordBox x:Name="txtClvAprob" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="162" Margin="145,0,0,0" MaxLength="10" IsEnabled="False" Visibility="Visible" />
                            <Button x:Name="btnGenerar" HorizontalAlignment="Left" Margin="312,0,0,0" VerticalAlignment="Top" Width="60" Height="40" Foreground="White" FontSize="16" Click="btnGenerar_Click">
                                <Button.Background>
                                    <SolidColorBrush Color="LightCoral" />
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Margin" Value="3"/>
                                        </Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Margin" Value="3"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Image Source="../../images/process.png" Width="30" Height="30" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnImprimir" HorizontalAlignment="Left" Margin="375,0,0,0" VerticalAlignment="Top" Width="60" Height="40" Foreground="White" FontSize="16" Click="btnImprimir_Click">
                                <Button.Background>
                                    <SolidColorBrush Color="LightCyan" />
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Resources>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Margin" Value="3"/>
                                        </Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Margin" Value="3"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Image Source="../../images/printer.png" Width="30" Height="30" />
                                </StackPanel>
                            </Button>
                            <Grid x:Name="TarjetaCoords" Margin="150,43,0,0">
                                <Image Source="../../images/tarjetaContactLessBase.png" HorizontalAlignment="Left" Height="140" VerticalAlignment="Top" Width="280"/>
                                <Label x:Name="f1c01" Content="" FontSize="13" Margin="23,20,0,0"/>
                                <Label x:Name="f1c02" Content="" FontSize="13" Margin="48,20,0,0"/>
                                <Label x:Name="f1c03" Content="" FontSize="13" Margin="73,20,0,0"/>
                                <Label x:Name="f1c04" Content="" FontSize="13" Margin="99,20,0,0"/>
                                <Label x:Name="f1c05" Content="" FontSize="13" Margin="125,20,0,0"/>
                                <Label x:Name="f1c06" Content="" FontSize="13" Margin="153,20,0,0"/>
                                <Label x:Name="f1c07" Content="" FontSize="13" Margin="177,20,0,0"/>
                                <Label x:Name="f1c08" Content="" FontSize="13" Margin="202,20,0,0"/>
                                <Label x:Name="f1c09" Content="" FontSize="13" Margin="227,20,0,0"/>
                                <Label x:Name="f1c10" Content="" FontSize="13" Margin="251,20,0,0"/>

                                <Label x:Name="f2c01" Content="" FontSize="13" Margin="23,45,0,0"/>
                                <Label x:Name="f2c02" Content="" FontSize="13" Margin="48,45,0,0"/>
                                <Label x:Name="f2c03" Content="" FontSize="13" Margin="73,45,0,0"/>
                                <Label x:Name="f2c04" Content="" FontSize="13" Margin="99,45,0,0"/>
                                <Label x:Name="f2c05" Content="" FontSize="13" Margin="125,45,0,0"/>
                                <Label x:Name="f2c06" Content="" FontSize="13" Margin="153,45,0,0"/>
                                <Label x:Name="f2c07" Content="" FontSize="13" Margin="177,45,0,0"/>
                                <Label x:Name="f2c08" Content="" FontSize="13" Margin="202,45,0,0"/>
                                <Label x:Name="f2c09" Content="" FontSize="13" Margin="227,45,0,0"/>
                                <Label x:Name="f2c10" Content="" FontSize="13" Margin="251,45,0,0"/>

                                <Label x:Name="f3c01" Content="" FontSize="13" Margin="23,68,0,0"/>
                                <Label x:Name="f3c02" Content="" FontSize="13" Margin="48,68,0,0"/>
                                <Label x:Name="f3c03" Content="" FontSize="13" Margin="73,68,0,0"/>
                                <Label x:Name="f3c04" Content="" FontSize="13" Margin="99,68,0,0"/>
                                <Label x:Name="f3c05" Content="" FontSize="13" Margin="125,68,0,0"/>
                                <Label x:Name="f3c06" Content="" FontSize="13" Margin="153,68,0,0"/>
                                <Label x:Name="f3c07" Content="" FontSize="13" Margin="177,68,0,0"/>
                                <Label x:Name="f3c08" Content="" FontSize="13" Margin="202,68,0,0"/>
                                <Label x:Name="f3c09" Content="" FontSize="13" Margin="227,68,0,0"/>
                                <Label x:Name="f3c10" Content="" FontSize="13" Margin="251,68,0,0"/>

                                <Label x:Name="f4c01" Content="" FontSize="13" Margin="23,89,0,0"/>
                                <Label x:Name="f4c02" Content="" FontSize="13" Margin="48,89,0,0"/>
                                <Label x:Name="f4c03" Content="" FontSize="13" Margin="73,89,0,0"/>
                                <Label x:Name="f4c04" Content="" FontSize="13" Margin="99,89,0,0"/>
                                <Label x:Name="f4c05" Content="" FontSize="13" Margin="125,89,0,0"/>
                                <Label x:Name="f4c06" Content="" FontSize="13" Margin="153,89,0,0"/>
                                <Label x:Name="f4c07" Content="" FontSize="13" Margin="177,89,0,0"/>
                                <Label x:Name="f4c08" Content="" FontSize="13" Margin="202,89,0,0"/>
                                <Label x:Name="f4c09" Content="" FontSize="13" Margin="227,89,0,0"/>
                                <Label x:Name="f4c10" Content="" FontSize="13" Margin="251,89,0,0"/>

                                <Label x:Name="f5c01" Content="" FontSize="13" Margin="23,111,0,0"/>
                                <Label x:Name="f5c02" Content="" FontSize="13" Margin="48,111,0,0"/>
                                <Label x:Name="f5c03" Content="" FontSize="13" Margin="73,111,0,0"/>
                                <Label x:Name="f5c04" Content="" FontSize="13" Margin="99,111,0,0"/>
                                <Label x:Name="f5c05" Content="" FontSize="13" Margin="125,111,0,0"/>
                                <Label x:Name="f5c06" Content="" FontSize="13" Margin="153,111,0,0"/>
                                <Label x:Name="f5c07" Content="" FontSize="13" Margin="177,111,0,0"/>
                                <Label x:Name="f5c08" Content="" FontSize="13" Margin="202,111,0,0"/>
                                <Label x:Name="f5c09" Content="" FontSize="13" Margin="227,111,0,0"/>
                                <Label x:Name="f5c10" Content="" FontSize="13" Margin="251,111,0,0"/>
                            </Grid>
                        </Grid>
                    </GroupBox>
                    
                </Grid>
            </TabItem>
            <TabItem Header="Permisos del Sistema" FontSize="16" Height="50" Margin="-2,0">
                <Grid x:Name="grdPermisos">
                    <GroupBox x:Name="grpPuede" Height="110" Margin="10,10,10,0" VerticalAlignment="Top" BorderBrush="Black" FontSize="16">
                        <GroupBox.Header>
                            <CheckBox x:Name="chkAllPue" Content="Puede" FontSize="6" VerticalContentAlignment="Center" Checked="chkAllPue_Checked" Unchecked="chkAllPue_Unchecked">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.5" ScaleY="2.5" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="134*"/>
                                <ColumnDefinition Width="287*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Dar Descuentos:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkDescuento" Tag="DSCT" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Dar Regalos:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="200,10,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                            <CheckBox x:Name="chkRegalos" Tag="GIFT" HorizontalAlignment="Left" Margin="42,10,0,0" VerticalAlignment="Top" IsChecked="True" Grid.Column="1">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Eliminar Pedidos:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="112,10,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <CheckBox x:Name="chkDelPedido" Tag="DPED" HorizontalAlignment="Left" Margin="252,10,0,0" VerticalAlignment="Top" IsChecked="True" Grid.Column="1">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Anular Facturas:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="312,10,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                            <CheckBox x:Name="chkAnulaFact" Tag="AFCT" HorizontalAlignment="Left" Margin="462,10,0,0" VerticalAlignment="Top" IsChecked="True" Grid.Column="1">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="grpAcciones" Height="300" Margin="10,130,10,0" VerticalAlignment="Top" BorderBrush="Black" FontSize="16">
                        <GroupBox.Header>
                            <CheckBox x:Name="chkAllAcc" Content="Acciones que puede realizar" FontSize="6" VerticalContentAlignment="Center" Checked="chkAllAcc_Checked" Unchecked="chkAllAcc_Unchecked">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.5" ScaleY="2.5" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </GroupBox.Header>
                        <Grid>
                            <Label Content="Vales de Ingreso:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkValIng" Tag="VING" HorizontalAlignment="Left" Margin="200,10,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Vales de Egreso:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="260,10,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkValEgr" Tag="VEGR" HorizontalAlignment="Left" Margin="440,10,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Grupos/Subgrups:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="500,10,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkGrps" Tag="GSGR" HorizontalAlignment="Left" Margin="650,10,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>



                            <Label Content="Usuarios/Empleados:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkUsuarios" Tag="USRE" HorizontalAlignment="Left" Margin="200,60,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Configuración:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="260,60,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkConfig" Tag="CONF" HorizontalAlignment="Left" Margin="440,60,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Pedidos:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="500,60,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkPedidos" Tag="PEDD" HorizontalAlignment="Left" Margin="650,60,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>


                            <Label Content="Ventas/Clientes:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkVentas" Tag="VENT" HorizontalAlignment="Left" Margin="200,110,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Compras:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="260,110,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkCompras" Tag="COMP" HorizontalAlignment="Left" Margin="440,110,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Inventario:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="500,110,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkInventario" Tag="INVT" HorizontalAlignment="Left" Margin="650,110,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>


                            <Label Content="Control de Caja:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkCaja" Tag="CAJA" HorizontalAlignment="Left" Margin="200,160,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Productos/Recetas:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="260,160,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkProductos" Tag="RCTA" HorizontalAlignment="Left" Margin="440,160,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Generar Reportes:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="500,160,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkReportes" Tag="RPTE" HorizontalAlignment="Left" Margin="650,160,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Label Content="Market/POS:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="500,210,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkMarket" Tag="MKT" HorizontalAlignment="Left" Margin="650,210,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>


                            <Label Content="Backup/Respaldo:" FontSize="16" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,210,0,0" VerticalAlignment="Top"/>
                            <CheckBox x:Name="chkBackup" Tag="BKPS" HorizontalAlignment="Left" Margin="200,210,0,0" VerticalAlignment="Top" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10, 10, 10, 10">
            <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,478,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#5cb85c" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/save.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Grabar</TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,478,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click">
                <Button.Background>
                    <SolidColorBrush Color="#d9534f" />
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </StackPanel.Resources>
                    <Image Source="../../images/cancel.png" Width="30" Height="30" />
                    <TextBlock VerticalAlignment="Center">Cancelar</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
