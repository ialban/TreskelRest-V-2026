<UserControl
             x:Class="TreskelRest.frms.ctls.ctlQuitaIngredientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TreskelRest.frms.ctls"
             xmlns:spinner="clr-namespace:LibControls.spinner;assembly=LibControls"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="600" d:DesignWidth="600">
    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="50" VerticalAlignment="Top">
                <Label x:Name="txtItem" Content="Label" FontSize="16" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                <Label Content="Cantidad:" FontSize="16" HorizontalAlignment="Right" Margin="0,10,190,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <spinner:ctlSpinner x:Name="txtCantidad" HorizontalAlignment="Right" Margin="0,6,10,0" VerticalAlignment="Top"/>
            </Grid>
            <Grid DockPanel.Dock="Bottom" Height="60" VerticalAlignment="Bottom">
                <Button x:Name="btnGrabar" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="120" Height="40" Foreground="White" FontSize="16" Click="btnGrabar_Click" Background="#5cb85c">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/save.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center"><Run Text="Grabar"/></TextBlock>
                    </StackPanel>
                </Button>
                <Button x:Name="btnCancelar" HorizontalAlignment="Left" Margin="150,10,0,0" VerticalAlignment="Top" Width="120" Height="40" FontSize="16" Foreground="White" Click="btnCancelar_Click" Background="#d9534f">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="3"/>
                            </Style>
                        </StackPanel.Resources>
                        <Image Source="../../images/cancel.png" Width="30" Height="30" />
                        <TextBlock VerticalAlignment="Center"><Run Text="Cancelar"/></TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid>
                <DataGrid x:Name="Resultado" Width="Auto" Height="380" Margin="0,0,0,0" VerticalAlignment="Top"
                  AlternationCount="2" AlternatingRowBackground="Aquamarine"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                  CanUserReorderColumns="True" CanUserAddRows="False" IsReadOnly="True"
                  FontSize="16" VerticalContentAlignment="Center" ColumnWidth="*" AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Acción" Width="80" >
                            <DataGridTemplateColumn.CellTemplate >
                                <DataTemplate>
                                    <Grid>
                                        <CheckBox IsChecked="true" Unchecked="CheckBox_Unchecked" Checked="CheckBox_Checked" Margin="3">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="2.5" ScaleY="2.5" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Codigo" Binding="{Binding codigo}" Width="150" />
                        <DataGridTextColumn Header="Ingrediente" Binding="{Binding nombre}" Width="300" />
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="White"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Grid Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
                <Image Source="../../images/message.png" Margin="10,400,0,0" Width="50" Height="50" VerticalAlignment="Top" HorizontalAlignment="Left" />
                <TextBox x:Name="txtObserv" Text="" Margin="70,390,10,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top" HorizontalAlignment="Left" Width="520" Height="90" FontSize="16"  />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
