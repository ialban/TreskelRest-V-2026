<Window x:Class="LibKeys.FullKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibKeys"
             mc:Ignorable="d" WindowStyle="None" WindowStartupLocation="CenterScreen"
             d:DesignHeight="525" Width="550" ResizeMode="NoResize">
    <UniformGrid Width="550" Height="525" Background="DarkGray" Rows="1" IsVisibleChanged="UniformGrid_IsVisibleChanged">
        <Grid Width="540" Height="515" Background="LightSteelBlue" Margin="3,7,7,3">
            <DockPanel LastChildFill="False" Margin="2,2,0,0">
                <StackPanel x:Name="Derecha" DockPanel.Dock="Right" Height="Auto" VerticalAlignment="Top" Width="76" Margin="0,0,6,0">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="cancelar" Content="Esc" Height="66" Width="66" FontSize="20" Background="Red" Foreground="White" FontWeight="Bold" />
                    <Button x:Name="clear" Width="66" Height="66">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/clear.png" Width="38" Height="38" />
                            <TextBlock Text="Clear" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="back" Width="66" Height="66">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/back.png" Width="38" Height="38" />
                            <TextBlock Text="Back" HorizontalAlignment="Center"  FontWeight="Bold" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="Shift" Height="66" Width="66" FontSize="20" FontWeight="Bold">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/shift.png" Width="38" Height="38" />
                            <TextBlock Text="Shift" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="cares" Content="123#" Height="66" Width="66" FontSize="18" FontWeight="Bold" />
                    <Button x:Name="enter" Width="66" Height="150" Background="GreenYellow">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/enter.png" Width="38" Height="38" />
                            <TextBlock Text="Enter" HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <UniformGrid x:Name="Top" DockPanel.Dock="Top" Width="450" Height="70" >
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </UniformGrid.Resources>
                    <TextBox x:Name="texto" TextWrapping="Wrap" Text="" Margin="0,0,0,0" FontSize="20" Width="450" Height="66"/>
                </UniformGrid>
                <Grid x:Name="Abajo" DockPanel.Dock="Bottom" Width="450" Height="70">
                    <Grid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Setter Property="Margin" Value="2"/>
                        </Style>
                    </Grid.Resources>
                    <Button x:Name="space" Tag=" " Width="164" Height="66" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/space.png" Width="38" Height="38" />
                            <TextBlock Text="Space" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="arroba" Tag="" Content="@" Width="66" Height="66"  Margin="170,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
                    <Button x:Name="punto" Tag="" Content="." Width="66" Height="66" Margin="238,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
                    <Button x:Name="coma" Tag="" Content="," Width="66" Height="66" Margin="308,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
                    <ToggleButton x:Name="comodin" Height="66" Width="66" FontSize="20" Margin="374,0,0,0" FontWeight="Bold" VerticalAlignment="Top">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/comodin.png" Width="50" Height="50" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <UniformGrid x:Name="Grid" Width="450" Height="Auto" Rows="5" Margin="6,0, 0, 0">
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </UniformGrid.Resources>
                    
                </UniformGrid>
            </DockPanel>
        </Grid>
    </UniformGrid>
</Window>
