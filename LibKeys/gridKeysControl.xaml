<Window x:Class="LibKeys.gridKeysControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LibKeys"
             WindowStyle="None" WindowStartupLocation="CenterScreen"
             mc:Ignorable="d" Background="White"
             d:DesignHeight="390" d:DesignWidth="600" Activated="Window_Activated">
    <UniformGrid Width="600" Height="390" Background="DarkGray" Rows="1" >
        <Grid Width="590" Height="380" Background="LightSteelBlue">
            <DockPanel LastChildFill="False" Margin="2,2,0,0">
                <StackPanel x:Name="Derecha" DockPanel.Dock="Right" Height="Auto" VerticalAlignment="Top" Width="76" Margin="0,0,6,0">
                    <StackPanel.Resources>
                        <Style TargetType="{x:Type ToggleButton}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="2.5"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="cancelar" Content="Esc" Height="66" Width="66" FontSize="20" Background="Red" Foreground="White" FontWeight="Bold" Click="cancelar_Click" />
                    <Button x:Name="clear" Width="66" Height="66" Click="clear_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/clear.png" Width="38" Height="38" />
                            <TextBlock Text="Clear" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="back" Width="66" Height="66" Click="back_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/back.png" Width="38" Height="38" />
                            <TextBlock Text="Back" HorizontalAlignment="Center"  FontWeight="Bold" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="enter" Width="66" Height="150" Background="GreenYellow" Click="enter_Click">
                        <StackPanel Orientation="Vertical">
                            <Image Source="/images/enter.png" Width="38" Height="38" />
                            <TextBlock Text="Enter" HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontSize="18" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid x:Name="Top" DockPanel.Dock="Top" Width="500" Height="70" >
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                        <Style TargetType="{x:Type Label}">
                            <Setter Property="Margin" Value="3"/>
                        </Style>
                    </Grid.Resources>
                    <Label x:Name="rotulo1" Content="A5" FontWeight="Bold" Margin="0,0,0,0" FontSize="22" Width="50" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <PasswordBox x:Name="texto1" Password="" Margin="60,0,0,0" FontSize="22" VerticalContentAlignment="Center" Width="100" Height="66" HorizontalAlignment="Left" MaxLength="2"/>
                    <Label x:Name="rotulo2" Content="A5" FontWeight="Bold" Margin="170,0,0,0" FontSize="22" Width="50" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <PasswordBox x:Name="texto2" Password="" Margin="230,0,0,0" FontSize="22" VerticalContentAlignment="Center" Width="100" Height="66" HorizontalAlignment="Left" MaxLength="2"/>
                    <Label x:Name="rotulo3" Content="A5" FontWeight="Bold" Margin="340,0,0,0" FontSize="22" Width="50" HorizontalAlignment="Left" VerticalContentAlignment="Center" />
                    <PasswordBox x:Name="texto3" Password="" Margin="400,0,0,0" FontSize="22" VerticalContentAlignment="Center" Width="100" Height="66" HorizontalAlignment="Left" MaxLength="2"/>
                </Grid>
                <UniformGrid x:Name="Grid" Width="220" Height="Auto" Rows="4" Margin="6,6, 0, 0">
                    <UniformGrid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="1"/>
                        </Style>
                    </UniformGrid.Resources>
