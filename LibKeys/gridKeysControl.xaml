                </UniformGrid>
                <Grid Width="270" Height="Auto" Margin="6,6, 0, 0">
                    <TextBlock FontSize="16" TextAlignment="Justify" Height="120"  VerticalAlignment="Top" TextWrapping="Wrap" Text="Use la tarjeta de códigos para ingresar los valores, para ello use los pictogramas mostrados, los cuáles representan un número específico, éstos se muestran en desorden" />
                    <Image Source="/images/grid_key.png" Margin="0, 120, 0, 0" VerticalAlignment="Top" />
