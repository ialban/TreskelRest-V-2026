<Project>
  <!-- Este evento se ejecutará automáticamente para cada uno de los 18 proyectos al compilar -->
  <Target Name="FirmarTodoMasivo" AfterTargets="Build" Condition="Exists('$(TargetPath)')">
    <Exec Command="&quot;C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe&quot; sign /fd SHA256 /f &quot;C:\Desarrollo\TreskelSoftV2026\TreskelRest-V-2026\CertificadoTreskelSoft.pfx&quot; /p &quot;Tr3sk3lS0ft&quot; /v &quot;$(TargetPath)&quot;" ContinueOnError="true" />
  </Target>
</Project>
